@model SmartHairSalonApp.Models.Salon

@{
    ViewData["Title"] = "Dodaj Novi Salon";
}

<div class="container py-4">
    <div class="border-bottom pb-3 mb-4">
        <h1 class="display-6 fw-bold text-dark"><i class="bi bi-plus-circle-fill text-primary me-2"></i>Dodaj Novi Salon</h1>
        <p class="text-muted mb-0">Unesite osnovne podatke o salonu i označite njegovu lokaciju na mapi.</p>
    </div>

    <div class="row g-5">
        <div class="col-lg-5 col-md-12">
            <div class="card shadow-sm border-0 p-4 bg-white rounded">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Naziv" class="form-label fw-semibold">Naziv salona</label>
                        <input asp-for="Naziv" class="form-control" placeholder="Npr. Frizerski salon Ogledalce" />
                        <span asp-validation-for="Naziv" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Lokacija" class="form-label fw-semibold">Adresa / Lokacija</label>
                        <input asp-for="Lokacija" class="form-control" placeholder="Npr. Vrbanja 1, Sarajevo" />
                        <span asp-validation-for="Lokacija" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-4">
                        <label asp-for="RadnoVrijeme" class="form-label fw-semibold">Radno vrijeme</label>
                        <input asp-for="RadnoVrijeme" class="form-control" placeholder="Npr. Pon - Sub: 08:00 - 20:00" />
                        <span asp-validation-for="RadnoVrijeme" class="text-danger"></span>
                    </div>

                    <hr />
                    <h5 class="text-muted mb-3"><i class="bi bi-geo-fill text-danger me-1"></i>Geografske koordinate</h5>
                    <p class="small text-muted mb-3">Kliknite bilo gdje na mapi sa desne strane kako biste automatski popunili ova polja.</p>

                    <div class="row g-2 mb-4">
                        <div class="col">
                            <label asp-for="Latitude" class="form-label small fw-semibold">Latitude (Širina)</label>
                            <input asp-for="Latitude" class="form-control" id="lat-input" placeholder="Npr. 43.8554" step="any" readonly />
                            <span asp-validation-for="Latitude" class="text-danger"></span>
                        </div>
                        <div class="col">
                            <label asp-for="Longitude" class="form-label small fw-semibold">Longitude (Dužina)</label>
                            <input asp-for="Longitude" class="form-control" id="lng-input" placeholder="Npr. 18.4081" step="any" readonly />
                            <span asp-validation-for="Longitude" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <input type="submit" value="Kreiraj Salon" class="btn btn-primary fw-bold py-2 shadow-sm" />
                        <a asp-action="Index" class="btn btn-outline-secondary py-2"><i class="bi bi-arrow-left me-1"></i> Nazad na listu</a>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-lg-7 col-md-12">
            <div class="card shadow-sm h-100 border-0 bg-light" style="min-height: 450px;">
                <div class="card-body p-2 d-flex flex-column">
                    <label class="form-label fw-semibold mb-2 px-2"><i class="bi bi-map me-1"></i> Odaberite lokaciju klika</label>
                    <div id="admin-map" class="rounded border flex-grow-1" style="min-height: 500px; z-index: 1;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        // Defaultni centar mape (Sarajevo)
        let defaultLat = 43.8563;
        let defaultLng = 18.4131;

        // 1. Inicijalizacija mape za admina
        const map = L.map('admin-map').setView([defaultLat, defaultLng], 13);

        // 2. Učitavanje izgleda mape (OpenStreetMap)
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap'
        }).addTo(map);

        // Varijabla koja drži marker (da imamo samo jedan na mapi)
        let trenutniMarker = null;

        // Povezivanje input polja iz forme
        const latInput = document.getElementById('lat-input');
        const lngInput = document.getElementById('lng-input');

        // 3. Osluškivanje klika na mapu
        map.on('click', function (e) {
        const kliknutoLat = e.latlng.lat;
        const kliknutoLng = e.latlng.lng;

        // Upiši vrijednosti u input polja (zaokruženo na 6 decimala radi preciznosti)
        latInput.value = kliknutoLat.toFixed(6);
        lngInput.value = kliknutoLng.toFixed(6);

        // Ako marker već postoji, samo mu pomjeri lokaciju, inače napravi novi
        if (trenutniMarker) {
        trenutniMarker.setLatLng(e.latlng);
        } else {
        trenutniMarker = L.marker(e.latlng).addTo(map);
        }

        trenutniMarker.bindPopup("<b>Odabrana lokacija salona</b>").openPopup();
        });

        // Opcionalno: Ako uređaj ima upaljenu geolokaciju, centriraj mapu na admina da lakše klikne svoj grad
        if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition((position) => {
        map.setView([position.coords.latitude, position.coords.longitude], 14);
        });
        }
        });
    </script>
}