@model SmartHairSalonApp.Models.Salon

@{
    ViewData["Title"] = "Dodaj Novi Salon";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<div class="container my-5" style="min-height: 80vh;">
    <div class="mb-5 pb-3 border-bottom border-light">
        <span class="text-uppercase tracking-widest text-gold fw-bold small d-block mb-2">Smart Hair Salon</span>
        <h2 style="font-family: 'Playfair Display', serif;" class="fw-bold text-uppercase tracking-wide text-dark m-0">
            Dodaj Novi Salon
        </h2>
        <p class="text-muted small text-uppercase tracking-wider m-0 mt-1">Unesite osnovne podatke o salonu i označite njegovu lokaciju na mapi.</p>
    </div>

    <div class="row g-4 align-items-stretch">
        <div class="col-lg-5 col-md-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white">
                <div style="height: 4px; background: linear-gradient(90deg, #D4AF37 0%, #F3E5AB 100%);"></div>
                <div class="card-body p-4 p-md-5 d-flex flex-column justify-content-between">
                    <form asp-action="Create" class="w-100">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        <div class="form-group mb-4">
                            <label asp-for="Naziv" class="form-label text-muted text-uppercase tracking-wider small fw-semibold">
                                <i class="bi bi-shop text-gold me-1"></i> Naziv salona
                            </label>
                            <input asp-for="Naziv" class="form-control custom-input" placeholder="Npr. Frizerski salon Ogledalce" />
                            <span asp-validation-for="Naziv" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Lokacija" class="form-label text-muted text-uppercase tracking-wider small fw-semibold">
                                <i class="bi bi-geo-alt text-gold me-1"></i> Adresa / Lokacija
                            </label>
                            <input asp-for="Lokacija" class="form-control custom-input" placeholder="Npr. Vrbanja 1, Sarajevo" />
                            <span asp-validation-for="Lokacija" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="RadnoVrijeme" class="form-label text-muted text-uppercase tracking-wider small fw-semibold">
                                <i class="bi bi-clock text-gold me-1"></i> Radno vrijeme
                            </label>
                            <input asp-for="RadnoVrijeme" class="form-control custom-input" placeholder="Npr. Pon - Sub: 08:00 - 20:00" />
                            <span asp-validation-for="RadnoVrijeme" class="text-danger small"></span>
                        </div>

                        <div class="pt-3 border-top border-light mt-4">
                            <h6 class="text-uppercase tracking-wider text-muted small fw-bold mb-2">
                                <i class="bi bi-geo-fill text-danger me-1"></i> Geografske koordinate
                            </h6>
                            <p class="font-xs text-muted mb-3">Kliknite bilo gdje na mapi desno da automatski popunite polja.</p>

                            <div class="row g-2 mb-4">
                                <div class="col">
                                    <label asp-for="Latitude" class="form-label font-xs text-uppercase tracking-wide text-muted mb-1">Latitude</label>
                                    <input asp-for="Latitude" class="form-control custom-input bg-light text-muted font-xs py-2" id="lat-input" placeholder="43.8554" step="any" readonly />
                                    <span asp-validation-for="Latitude" class="text-danger small"></span>
                                </div>
                                <div class="col">
                                    <label asp-for="Longitude" class="form-label font-xs text-uppercase tracking-wide text-muted mb-1">Longitude</label>
                                    <input asp-for="Longitude" class="form-control custom-input bg-light text-muted font-xs py-2" id="lng-input" placeholder="18.4081" step="any" readonly />
                                    <span asp-validation-for="Longitude" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex flex-column gap-2 pt-3 border-top border-light">
                            <button type="submit" class="btn btn-dark w-100 rounded-pill text-uppercase btn-premium-dark shadow-sm py-2">Kreiraj Salon</button>
                            <a asp-action="Index" class="btn btn-outline-secondary w-100 rounded-pill text-uppercase btn-custom-outline py-2">
                                <i class="bi bi-arrow-left me-1"></i> Nazad na listu
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7 col-md-12">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 bg-white">
                <div style="height: 4px; background: linear-gradient(90deg, #D4AF37 0%, #F3E5AB 100%);"></div>
                <div class="card-body p-3 d-flex flex-column h-100">
                    <label class="form-label text-muted text-uppercase tracking-wider small fw-semibold mb-3 px-1">
                        <i class="bi bi-map text-gold me-1"></i> Odaberite lokaciju na mapi
                    </label>
                    <div id="admin-map" class="rounded-3 border flex-grow-1 w-100" style="min-height: 480px; z-index: 1;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: #D4AF37 !important;
    }

    .tracking-wide {
        letter-spacing: 0.05em;
    }

    .tracking-wider {
        letter-spacing: 0.1em;
    }

    .tracking-widest {
        letter-spacing: 0.2em;
    }

    .font-xs {
        font-size: 0.75rem;
        font-weight: 600;
    }

    .custom-input {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 12px 16px;
        font-size: 0.95rem;
        transition: all 0.2s ease;
        min-height: 50px;
    }

        .custom-input:focus {
            border-color: #D4AF37;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
            outline: none;
        }

    .btn-premium-dark {
        background-color: #1a1a1a;
        border: 1px solid #1a1a1a;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        transition: all 0.25s ease;
    }

        .btn-premium-dark:hover {
            background-color: #000000;
            border-color: #D4AF37;
        }

    .btn-custom-outline {
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 50px;
        transition: all 0.2s ease;
    }

        .btn-custom-outline:hover {
            border-color: #1a1a1a;
            color: #1a1a1a;
        }
</style>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
        let defaultLat = 43.8563;
        let defaultLng = 18.4131;

        const map = L.map('admin-map').setView([defaultLat, defaultLng], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap'
        }).addTo(map);

        let trenutniMarker = null;
        const latInput = document.getElementById('lat-input');
        const lngInput = document.getElementById('lng-input');

        map.on('click', function (e) {
        const kliknutoLat = e.latlng.lat;
        const kliknutoLng = e.latlng.lng;

        latInput.value = kliknutoLat.toFixed(6);
        lngInput.value = kliknutoLng.toFixed(6);

        if (trenutniMarker) {
        trenutniMarker.setLatLng(e.latlng);
        } else {
        trenutniMarker = L.marker(e.latlng).addTo(map);
        }

        trenutniMarker.bindPopup("<b style='color: #1a1a1a;'>Odabrana lokacija salona</b>").openPopup();
        });

        if (navigator.geolocation) {
        navigator.geolocation.getCurrentPosition((position) => {
        map.setView([position.coords.latitude, position.coords.longitude], 14);
        });
        }
        });
    </script>
}