@model IEnumerable<SmartHairSalonApp.Models.Salon>

@{
    ViewData["Title"] = "Naše Lokacije";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-5">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-5 pb-3 border-bottom border-light">
        <div>
            <span class="text-uppercase tracking-widest text-gold fw-bold small d-block mb-2">Pronađite Nas</span>
            <h2 class="fw-bold text-uppercase tracking-wide text-dark m-0" style="font-family: 'Playfair Display', serif;">Naši Saloni</h2>
            <p class="text-muted small text-uppercase tracking-wider m-0 mt-1">Pronađite najbliži salon, pogledajte radno vrijeme i lokaciju na mapi.</p>
        </div>
        @if (User.IsInRole("admin"))
        {
            <a asp-action="Create" class="btn btn-dark shadow-sm px-4 fw-semibold rounded-pill text-uppercase btn-premium-dark mt-3 mt-sm-0">
                Dodaj Novi Salon
            </a>
        }
    </div>

    <div class="row g-4">
        <div class="col-lg-5 col-md-12">
            <div class="d-flex flex-column gap-3 custom-scrollbar" style="max-height: 600px; overflow-y: auto; padding-right: 8px;">
                @foreach (var item in Model)
                {
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white position-relative transition-card h-100">
                        <div style="width: 4px; background: linear-gradient(180deg, #D4AF37 0%, #F3E5AB 100%); position: absolute; left: 0; top: 0; bottom: 0;"></div>

                        <div class="card-body p-4 ps-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h4 class="fw-bold text-dark m-0" style="font-family: 'Playfair Display', serif; font-size: 1.25rem;">@item.Naziv</h4>
                                @if (User.IsInRole("admin"))
                                {
                                    <div class="btn-group shadow-sm rounded-3 overflow-hidden border border-light bg-white">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-white btn-sm px-2 border-end" title="Uredi"><i class="bi bi-pencil text-muted"></i></a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-white btn-sm px-2" title="Obriši"><i class="bi bi-trash3 text-danger"></i></a>
                                    </div>
                                }
                            </div>

                            <p class="card-text text-muted small mb-2">
                                <i class="bi bi-geo-alt text-gold me-2"></i><strong>Adresa:</strong> @item.Lokacija
                            </p>
                            <p class="card-text text-muted small mb-4">
                                <i class="bi bi-clock text-gold me-2"></i><strong>Radno vrijeme:</strong> @item.RadnoVrijeme
                            </p>

                            <div class="d-flex gap-2 pt-2 border-top border-light">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary px-3 rounded-pill text-uppercase btn-custom-outline flex-grow-1 text-center">
                                    Detalji i Frizeri
                                </a>

                                @if (!User.IsInRole("admin") && !User.IsInRole("zaposlenik"))
                                {
                                    <a asp-controller="Rezervacija"
                                       asp-action="Create"
                                       class="btn btn-dark px-3 rounded-pill text-uppercase btn-premium-dark shadow-sm flex-grow-1 text-center">
                                        Rezerviši Ovdje
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
                @if (!Model.Any())
                {
                    <div class="text-center p-5 bg-white shadow-sm rounded-4 border border-light">
                        <i class="bi bi-geo-alt text-muted mb-3 d-block" style="font-size: 3rem;"></i>
                        <p class="text-muted text-uppercase tracking-wider small m-0">Trenutno nema registrovanih salona u sistemu.</p>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-7 col-md-12">
            <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden bg-white position-relative" style="min-height: 550px;">
                <div style="height: 4px; background: linear-gradient(90deg, #D4AF37 0%, #F3E5AB 100%); position: absolute; top: 0; left: 0; right: 0; z-index: 10;"></div>
                <div id="map" class="w-100 h-100 rounded-4" style="min-height: 550px; z-index: 1;"></div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<style>
    .text-gold {
    color: #D4AF37 !important;
    }

    .tracking-wide {
    letter-spacing: 0.05em;
    }

    .tracking-wider {
    letter-spacing: 0.1em;
    }

    .tracking-widest {
    letter-spacing: 0.2em;
    }

    .btn-premium-dark {
    background-color: #1a1a1a;
    border: 1px solid #1a1a1a;
    font-size: 0.75rem;
    font-weight: 600;
    transition: all 0.25s ease;
    }

    .btn-premium-dark:hover {
    background-color: #000000;
    border-color: #D4AF37;
    }

    .btn-custom-outline {
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 50px;
    transition: all 0.2s ease;
    }

    .btn-custom-outline:hover {
    border-color: #1a1a1a;
    color: #1a1a1a;
    background-color: transparent;
    }

    .btn-white {
    background-color: #ffffff;
    border: none;
    }

    .btn-white:hover {
    background-color: #fafafa;
    }

    .transition-card {
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .transition-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 .5rem 1.5rem rgba(214, 175, 55, 0.08) !important;
    }

    /* Fini custom scrollbar za listu */
    .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 10px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #D4AF37;
    border-radius: 10px;
    }

    .leaflet-container {
    width: 100%;
    height: 100%;
    }

    /* Stilovi za pop-up unutar mape da prate premium temu */
    .premium-popup h6 {
    font-family: 'Playfair Display', serif;
    font-weight: bold;
    color: #1a1a1a;
    margin: 0 0 6px 0;
    font-size: 0.95rem;
    }

    .premium-popup p {
    margin: 0 0 4px 0;
    font-size: 0.75rem;
    color: #6c757d;
    }

    .premium-popup .btn-pop {
    background-color: #1a1a1a;
    color: #ffffff !important;
    font-size: 0.7rem;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-decoration: none;
    padding: 5px 10px;
    border-radius: 20px;
    display: block;
    text-center;
    margin-top: 8px;
    transition: all 0.2s ease;
    }

    .premium-popup .btn-pop:hover {
    background-color: #000000;
    color: #D4AF37 !important;
    }
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {
    let defaultLat = 43.8563;
    let defaultLng = 18.4131;

    const map = L.map('map').setView([defaultLat, defaultLng], 13);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    attribution: '© OpenStreetMap'
    }).addTo(map);

    if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(
    (position) => {
    const userLat = position.coords.latitude;
    const userLng = position.coords.longitude;
    map.setView([userLat, userLng], 14);

    L.circle([userLat, userLng], {
    color: '#D4AF37',
    fillColor: '#D4AF37',
    fillOpacity: 0.15,
    radius: 300
    }).addTo(map).bindPopup("<b style='font-family: sans-serif; font-size:12px;'>Vi ste ovdje</b>").openPopup();
    },
    () => {
    console.log("Korisnik je odbio geolokaciju.");
    }
    );
    }

    fetch('/api/saloniapi')
    .then(response => response.json())
    .then(saloni => {
    saloni.forEach(salon => {
    if (salon.latitude && salon.longitude) {
    const marker = L.marker([salon.latitude, salon.longitude]).addTo(map);

    // 🔥 POPRAVLJENO: Izgled popup prozora na mapi je usklađen sa zlatnom temom
    const popupSadrzaj = `
    <div class="premium-popup" style="min-width: 160px;">
    <h6>${salon.naziv}</h6>
    <p><i class="bi bi-geo-alt text-gold"></i> ${salon.lokacija}</p>
    <p><i class="bi bi-clock text-gold"></i> ${salon.radnoVrijeme}</p>
    <a href="/Salon/Details/${salon.id}" class="btn-pop text-center">
    Detalji i Frizeri
    </a>
    </div>
    `;

    marker.bindPopup(popupSadrzaj);
    }
    });
    })
    .catch(error => console.error('Greška sa API-jem:', error));
    });
</script>