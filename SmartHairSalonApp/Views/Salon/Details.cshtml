@model SmartHairSalonApp.Models.Salon

@{
    ViewData["Title"] = Model.Naziv + " - Detalji";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-5">
    <div class="mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary px-3 rounded-pill text-uppercase btn-custom-outline btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Nazad na sve salone
        </a>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden mb-5 rounded-4 text-white position-relative" style="min-height: 250px;">
        <div class="position-absolute w-100 h-100" style="background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.85)), url('https://images.unsplash.com/photo-1560066984-138dadb4c035?q=80&w=1474&auto=format&fit=crop') center/cover; z-index: 1;"></div>
        <div style="height: 4px; background: linear-gradient(90deg, #D4AF37 0%, #F3E5AB 100%); position: absolute; top: 0; left: 0; right: 0; z-index: 3;"></div>

        <div class="card-body p-4 p-md-5 position-relative d-flex align-items-center" style="z-index: 2;">
            <div class="row align-items-center w-100 g-4">
                <div class="col-md-8">
                    <span class="text-uppercase tracking-widest text-gold fw-bold small d-block mb-2">Ekskluzivna Lokacija</span>
                    <h1 class="fw-bold text-uppercase tracking-wide display-5 m-0 mb-2" style="font-family: 'Playfair Display', serif;">@Model.Naziv</h1>
                    <p class="fs-6 text-light opacity-90 m-0">
                        <i class="bi bi-geo-alt text-gold me-2"></i>@Model.Lokacija
                    </p>
                </div>
                <div class="col-md-4 text-md-end mt-0">
                    <div class="bg-white bg-opacity-10 backdrop-blur p-3 rounded-3 d-inline-block border border-white border-opacity-10 text-start text-md-end">
                        <h6 class="text-uppercase font-xs fw-bold text-muted-white mb-1"><i class="bi bi-clock text-gold me-1"></i> Radno Vrijeme</h6>
                        <p class="fs-5 fw-semibold mb-0 tracking-wide">@Model.RadnoVrijeme</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-5">
        <div class="col-lg-7">
            <div class="mb-4 pb-2 border-bottom border-light">
                <h3 class="fw-bold text-uppercase tracking-wide m-0 text-dark" style="font-family: 'Playfair Display', serif; font-size: 1.5rem;">
                    <i class="bi bi-stars text-gold me-2"></i>O našem salonu
                </h3>
            </div>

            <p class="lead text-secondary justify-text mb-4" style="font-size: 1.05rem;">
                Dobrodošli u <strong>@Model.Naziv</strong>, oazu ljepote i stila smještenu u samom srcu Sarajeva. Naš salon predstavlja spoj vrhunske estetike, najsavremenijih tehnika stilizovanja kose i strasti prema kreiranju savršenog izgleda za svakog klijenta.
            </p>
            <p class="text-muted justify-text mb-5" style="font-size: 0.95rem; line-height: 1.6;">
                Ponosimo se upotrebom isključivo luksuznih i svjetski priznatih <strong>Kérastase Paris</strong> preparata koji dubinski njeguju, obnavljaju i štite vašu kosu od korijena do vrhova. Bez obzira da li želite potpunu transformaciju boje, modernu urbanu frizuru ili napredni <strong>Kérastase ritual</strong> njege i oporavka, naš ekspertni tim stručnjakinja je tu da vaše želje pretvori u stvarnost. Svakom klijentu pristupamo individualno, analizirajući teksturu kose i oblik lica kako bismo postigli maksimalan efekat.
            </p>

            <div class="row g-3 my-4">
                <div class="col-6 col-md-4">
                    <div class="p-3 border border-light rounded-4 text-center bg-white shadow-sm h-100 box-amenity">
                        <i class="bi bi-gem text-gold fs-3 d-block mb-2"></i>
                        <h6 class="fw-bold text-dark small mb-2">Luksuzna Njega</h6>
                        <small class="text-white bg-dark px-2 py-1 rounded-pill font-xs text-uppercase tracking-wide">Kérastase</small>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="p-3 border border-light rounded-4 text-center bg-white shadow-sm h-100 box-amenity">
                        <i class="bi bi-cup-hot text-gold fs-3 d-block mb-2"></i>
                        <h6 class="fw-bold text-dark small mb-1">Besplatna Kafa</h6>
                        <small class="text-muted font-xs">Za sve klijente</small>
                    </div>
                </div>
                <div class="col-6 col-md-4 mx-auto">
                    <div class="p-3 border border-light rounded-4 text-center bg-white shadow-sm h-100 box-amenity">
                        <i class="bi bi-wifi text-gold fs-3 d-block mb-2"></i>
                        <h6 class="fw-bold text-dark small mb-1">Brzi Wi-Fi</h6>
                        <small class="text-muted font-xs">Besplatan pristup</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="mb-4 pb-2 border-bottom border-light">
                <h3 class="fw-bold text-uppercase tracking-wide m-0 text-dark" style="font-family: 'Playfair Display', serif; font-size: 1.5rem;">
                    <i class="bi bi-people text-gold me-2"></i>Naš Ekspertni Tim
                </h3>
            </div>

            <div class="d-flex flex-column gap-3">

                <div class="card border-0 shadow-sm bg-white p-3 rounded-4 transition-hover position-relative overflow-hidden">
                    <div style="width: 3px; background: #1a1a1a; position: absolute; left: 0; top: 0; bottom: 0;"></div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold fs-4 shadow-sm avatar-premium">
                            AŠ
                        </div>
                        <div class="w-100">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="fw-bold text-dark m-0" style="font-family: 'Playfair Display', serif;">Amra Šarić</h5>
                                <span class="badge bg-gold-light text-gold px-2 py-1 rounded small tracking-wide font-xs text-uppercase">Art Direktor</span>
                            </div>
                            <p class="font-xs text-muted mb-1 mt-1">Specijalnost: <b>Napredno žensko šišanje</b></p>
                            <p class="text-secondary card-description m-0">Sa više od 10 godina međunarodnog iskustva, Amra je vizionar salona zadužena za geometrijska šišanja i transformacije imidža.</p>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm bg-white p-3 rounded-4 transition-hover position-relative overflow-hidden">
                    <div style="width: 3px; background: #1a1a1a; position: absolute; left: 0; top: 0; bottom: 0;"></div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold fs-4 shadow-sm avatar-premium">
                            EM
                        </div>
                        <div class="w-100">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="fw-bold text-dark m-0" style="font-family: 'Playfair Display', serif;">Ema Mehmedović</h5>
                                <span class="badge bg-gold-light text-gold px-2 py-1 rounded small tracking-wide font-xs text-uppercase">Master Colorist</span>
                            </div>
                            <p class="font-xs text-muted mb-1 mt-1">Specijalnost: <b>Balayage & Kérastase</b></p>
                            <p class="text-secondary card-description m-0">Ekspert za luksuzne tehnike posvjetljivanja kose. Specijalizovana za dubinsku njegu i Kérastase protokole obnove oštećene vlasi.</p>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm bg-white p-3 rounded-4 transition-hover position-relative overflow-hidden">
                    <div style="width: 3px; background: #1a1a1a; position: absolute; left: 0; top: 0; bottom: 0;"></div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold fs-4 shadow-sm avatar-premium">
                            NH
                        </div>
                        <div class="w-100">
                            <div class="d-flex justify-content-between align-items-start">
                                <h5 class="fw-bold text-dark m-0" style="font-family: 'Playfair Display', serif;">Nejra Hadžić</h5>
                                <span class="badge bg-gold-light text-gold px-2 py-1 rounded small tracking-wide font-xs text-uppercase">Senior Barber</span>
                            </div>
                            <p class="font-xs text-muted mb-1 mt-1">Specijalnost: <b>Muški Fade & Brada</b></p>
                            <p class="text-secondary card-description m-0">Dokaz da su žene majstori i muškog šišanja. Nejra je regionalno prepoznata po hirurški preciznim fade-ovima i modernom dizajnu brada.</p>
                        </div>
                    </div>
                </div>
            </div>

            @if (!User.IsInRole("admin") && !User.IsInRole("zaposlenik"))
            {
                <div class="d-grid mt-4 pt-2">
                    <a asp-controller="Rezervacija" asp-action="Create" class="btn btn-dark btn-lg py-3 rounded-pill text-uppercase btn-premium-dark shadow-sm">
                        <i class="bi bi-calendar-check text-gold me-2"></i> Rezerviši termin ovdje
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: #D4AF37 !important;
    }

    .bg-gold-light {
        background-color: #fdfaf2;
        border: 1px solid #f3ebd3;
    }

    .tracking-wide {
        letter-spacing: 0.05em;
    }

    .tracking-wider {
        letter-spacing: 0.1em;
    }

    .tracking-widest {
        letter-spacing: 0.2em;
    }

    .font-xs {
        font-size: 0.7rem;
        font-weight: 600;
    }

    .backdrop-blur {
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .text-muted-white {
        color: rgba(255, 255, 255, 0.7);
    }

    .justify-text {
        text-align: justify;
    }

    .btn-premium-dark {
        background-color: #1a1a1a;
        border: 1px solid #1a1a1a;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        transition: all 0.25s ease;
    }

        .btn-premium-dark:hover {
            background-color: #000000;
            border-color: #D4AF37;
        }

    .btn-custom-outline {
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 50px;
        transition: all 0.2s ease;
    }

        .btn-custom-outline:hover {
            border-color: #1a1a1a;
            color: #1a1a1a;
            background-color: transparent;
        }

    .avatar-premium {
        width: 60px;
        height: 60px;
        min-width: 60px;
        background: #1a1a1a;
        color: #D4AF37 !important;
        border: 1px solid #D4AF37;
        font-family: 'Playfair Display', serif;
    }

    .box-amenity {
        transition: all 0.2s ease;
    }

        .box-amenity:hover {
            border-color: #eaddbd !important;
            background-color: #fcf9f2 !important;
        }

    .transition-hover {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .transition-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 .5rem 1rem rgba(214, 175, 55, 0.05) !important;
        }

    .card-description {
        font-size: 13px;
        line-height: 1.4;
    }
</style>