@using Microsoft.AspNetCore.Identity
@using SmartHairSalonApp.Models
@inject SignInManager<Korisnik> SignInManager
@inject UserManager<Korisnik> UserManager
@inject SmartHairSalonApp.Data.ApplicationDbContext _context

@{
    int brojObavijesti = 0;
    List<SmartHairSalonApp.Models.Obavijest> listaObavijesti = new List<SmartHairSalonApp.Models.Obavijest>();

    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var trenutniKorisnikId = UserManager.GetUserId(User);

        if (trenutniKorisnikId != null)
        {
            // Razdvajamo uloge radi preciznijeg filtriranja na zvoncu
            bool jeAdmin = User.IsInRole("admin") || User.IsInRole("Admin");
            bool jeZaposlenik = User.IsInRole("zaposlenik") || User.IsInRole("Zaposlenik");

            if (jeAdmin)
            {
                // Admin na svom zvoncu vidi i nove narudžbe (SALON:) i nove registracije (ADMIN:)
                listaObavijesti = _context.Obavijesti
                    .Where(o => o.Poruka.StartsWith("SALON:") || o.Poruka.StartsWith("ADMIN:"))
                    .OrderByDescending(o => o.Datum)
                    .Take(5)
                    .ToList();
            }
            else if (jeZaposlenik)
            {
                // Zaposlenik na svom zvoncu vidi SAMO nove narudžbe za salon
                listaObavijesti = _context.Obavijesti
                    .Where(o => o.Poruka.StartsWith("SALON:"))
                    .OrderByDescending(o => o.Datum)
                    .Take(5)
                    .ToList();
            }
            else
            {
                // Obični klijent vidi samo lične poruke poslane njemu
                listaObavijesti = _context.Obavijesti
                    .Where(o => o.KorisnikId == trenutniKorisnikId && !o.Poruka.StartsWith("SALON:") && !o.Poruka.StartsWith("ADMIN:"))
                    .OrderByDescending(o => o.Datum)
                    .Take(5)
                    .ToList();
            }

            brojObavijesti = listaObavijesti.Count;
        }
    }
}

<!DOCTYPE html>
<html lang="bs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Hair Salon</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SmartHairSalonApp.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-xl navbar-light custom-navbar py-4">
            <div class="container">

                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg class="me-3" width="38" height="38" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2C9.5 2 8 3.5 8 6C8 7.5 8.5 8.5 9.5 9.5C8.5 8.5 7.5 8 6 8C3.5 8 2 9.5 2 12C2 14.5 3.5 16 6 16C7.5 16 8.5 15.5 9.5 14.5C8.5 15.5 8 16.5 8 18C8 20.5 9.5 22 12 22C14.5 22 16 20.5 16 18C16 16.5 15.5 15.5 14.5 14.5C15.5 15.5 16.5 16 18 16C20.5 16 22 14.5 22 12C22 9.5 20.5 8 18 8C16.5 8 15.5 8.5 14.5 9.5C15.5 8.5 16 7.5 16 6C16 3.5 14.5 2 12 2Z" stroke="#8c7a6b" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M12 9.5C13.3807 9.5 14.5 8.38071 14.5 7C14.5 5.61929 13.3807 4.5 12 4.5C10.6193 4.5 9.5 5.61929 9.5 7C9.5 8.38071 10.6193 9.5 12 9.5Z" stroke="#8c7a6b" stroke-width="1.2" />
                        <path d="M12 19.5C13.3807 19.5 14.5 18.3807 14.5 17C14.5 15.6193 13.3807 14.5 12 14.5C10.6193 14.5 9.5 15.6193 9.5 17C9.5 18.3807 10.6193 19.5 12 19.5Z" stroke="#8c7a6b" stroke-width="1.2" />
                        <path d="M17 14.5C18.3807 14.5 19.5 13.3807 19.5 12C19.5 10.6193 18.3807 9.5 17 9.5C15.6193 9.5 14.5 10.6193 14.5 12C14.5 13.3807 15.6193 14.5 17 14.5Z" stroke="#8c7a6b" stroke-width="1.2" />
                        <path d="M7 14.5C8.38071 14.5 9.5 13.3807 9.5 12C9.5 10.6193 8.38071 9.5 7 9.5C5.61929 9.5 4.5 10.6193 4.5 12C4.5 13.3807 5.61929 14.5 7 14.5Z" stroke="#8c7a6b" stroke-width="1.2" />
                    </svg>
                    <span class="logo-text">Smart Hair Salon</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-xl-inline-flex justify-content-between">
                    <ul class="navbar-nav mx-auto gap-4">
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" asp-area="" asp-controller="Home" asp-action="Index">Početna</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" asp-area="" asp-controller="Salon" asp-action="Index">Lokacije</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" asp-area="" asp-controller="Usluga" asp-action="Index">Usluge</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" asp-area="" asp-controller="Proizvod" asp-action="Index">Shop</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link" asp-area="" asp-controller="Rezervacija" asp-action="Index">Rezervacije</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-4 h-icons-wrapper">

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <div class="dropdown d-inline-block" id="notif-wrapper">
                                <a href="#" class="text-decoration-none nav-icon-btn dropdown-toggle no-caret position-relative" id="notifDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-bell"></i>
                                    @if (brojObavijesti > 0)
                                    {
                                        <span id="brojac-obavijesti" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.6rem; transform: translate(-20%, -10%);">
                                            @brojObavijesti
                                        </span>
                                    }
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-3" aria-labelledby="notifDropdown" style="min-width: 300px; border-radius: 16px; background-color: #fbfbfa;">
                                    <li class="dropdown-header text-dark fw-bold border-bottom pb-2 mb-2 fs-6 d-flex justify-content-between align-items-center" style="font-family: 'Playfair Display', serif;">
                                        <span>Obavještenja</span>
                                        @if (brojObavijesti > 0)
                                        {
                                            <button onclick="oznaciSveProcitano(event)" class="btn btn-sm p-0 border-0 text-success" title="Označi sve kao pročitano" style="font-size: 1.1rem;">
                                                <i class="bi bi-check2-all"></i>
                                            </button>
                                        }
                                    </li>
                                    <div id="lista-notifikacija-kontejner">
                                        @if (brojObavijesti == 0)
                                        {
                                            <li class="text-muted text-center py-3 small nema-poruka-tekst">Trenutno nema novih poruka.</li>
                                        }
                                        else
                                        {
                                            foreach (var ob in listaObavijesti)
                                            {
                                                bool jeAdminPoruka = ob.Poruka.StartsWith("ADMIN:");
                                                string borderBoja = jeAdminPoruka ? "#8c7a6b" : "#2b3a22";

                                                <li>
                                                    <a class="dropdown-item small p-2 rounded mb-2 text-wrap text-dark d-flex align-items-start pojedinacna-obavijest"
                                                       style="background-color: #f4f1ed; border-left: 4px solid @borderBoja;"
                                                       asp-controller="Narudzba" asp-action="Index">

                                                        @if (jeAdminPoruka)
                                                        {
                                                            <i class="bi bi-person-plus-fill me-2 mt-1" style="color: #8c7a6b;"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="bi bi-chat-left-dots-fill me-2 mt-1" style="color: #2b3a22;"></i>
                                                        }

                                                        <div>
                                                            @ob.Poruka
                                                            <div class="text-muted" style="font-size: 0.75rem;">@ob.Datum.ToString("HH:mm")</div>
                                                        </div>
                                                    </a>
                                                </li>
                                            }
                                            <li><hr class="dropdown-divider"></li>
                                            <li class="text-center">
                                                <a asp-controller="Narudzba" asp-action="Index" class="text-decoration-none small fw-bold" style="color: #2b3a22;">Pogledaj sve narudžbe</a>
                                            </li>
                                        }
                                    </div>
                                </ul>
                            </div>

                            <div class="position-relative d-inline-block">
                                <a href="/Proizvod/Basket" class="btn p-0 border-0 nav-icon-btn position-relative" title="Korpa">
                                    <i class="bi bi-cart3"></i>
                                    <span id="brojac-proizvoda" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem; padding: 0.25em 0.5em;">
                                        0
                                    </span>
                                </a>
                            </div>

                            <div class="dropdown">
                                <a href="#" class="text-decoration-none nav-icon-btn dropdown-toggle no-caret" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle text-success"></i>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="userMenu">
                                    <li><a class="dropdown-item small" asp-controller="Narudzba" asp-action="Index">Narudžbe</a></li>
                                    <li><a class="dropdown-item small" asp-area="Identity" asp-page="/Account/Manage/Index">Moj Profil</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                            <button type="submit" class="dropdown-item small text-danger">Odjavi se</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-area="Identity" asp-page="/Account/Login" class="text-decoration-none custom-nav-link fw-semibold" style="font-size: 0.95rem;">Prijava</a>
                            <a asp-area="Identity" asp-page="/Account/Register" class="text-decoration-none nav-icon-btn" title="Registracija">
                                <i class="bi bi-person-badge"></i>
                            </a>
                        }
                    </div>
                </div>

            </div>
        </nav>
    </header>

    <div class="container-fluid p-0 flex-grow-1">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="py-4 mt-auto">
        <div class="container text-center text-muted small">
            <hr class="mb-4 opacity-10">
            <p class="mb-0" style="color: #555c54;">&copy; 2026 - <span class="fw-bold" style="font-family: 'Playfair Display';">Smart Hair Salon</span>. Sva prava zadržana.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
        if (document.getElementById('brojac-proizvoda')) {
        osvjeziKorpuIzBaze();
        }

        if (sessionStorage.getItem("obavijestiProcitane") === "true") {
        ukloniBrojacObavijesti();
        }
        });

        function osvjeziKorpuIzBaze() {
        fetch('/Proizvod/DohvatiKorpu')
        .then(res => {
        if(!res.ok) throw new Error("Problem sa učitavanjem");
        return res.json();
        })
        .then(data => azurirajBadgeKorpe(data))
        .catch(err => console.error("Greška pri dohvaćanju korpe:", err));
        }

        function daddUKorpu(id) {
        fetch(`/Proizvod/DodajUKorpu?id=${id}`, { method: 'POST' })
        .then(res => res.json())
        .then(data => {
        azurirajBadgeKorpe(data);
        })
        .catch(err => console.error("Greška:", err));
        }

        function promijeniKolicinu(id, promjena) {
        fetch(`/Proizvod/PromijeniKolicinu?id=${id}&promjena=${promjena}`, { method: 'POST' })
        .then(res => res.json())
        .then(data => {
        azurirajBadgeKorpe(data);
        if(window.location.pathname.includes("Basket")) {
        window.location.reload();
        }
        });
        }

        function ukloniIzKorpe(id) {
        fetch(`/Proizvod/UkloniIzKorpe?id=${id}`, { method: 'POST' })
        .then(res => res.json())
        .then(data => {
        azurirajBadgeKorpe(data);
        if(window.location.pathname.includes("Basket")) {
        window.location.reload();
        }
        });
        }

        function azurirajBadgeKorpe(korpa) {
        const brojac = document.getElementById('brojac-proizvoda');
        let ukupnoArtikala = 0;

        if (korpa && korpa.length > 0) {
        korpa.forEach(item => {
        // Osiguravamo mapiranje bez obzira na to da li C# vraća 'kolicina' ili 'Kolicina'
        ukupnoArtikala += (item.kolicina || item.Kolicina || 0);
        });
        }
        if (brojac) {
        brojac.innerText = ukupnoArtikala;
        }
        }

        function oznaciSveProcitano(event) {
        event.stopPropagation();
        event.preventDefault();

        ukloniBrojacObavijesti();
        sessionStorage.setItem("obavijestiProcitane", "true");
        }

        function ukloniBrojacObavijesti() {
        const brojac = document.getElementById('brojac-obavijesti');
        if (brojac) {
        brojac.remove();
        }

        const stavke = document.querySelectorAll('.pojedinacna-obavijest');
        stavke.forEach(item => {
        item.style.opacity = "0.6";
        item.style.borderLeft = "4px solid #999";
        });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<style>
    .custom-navbar {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: transparent !important;
    }

    .logo-text {
    font-family: 'Playfair Display', serif;
    font-size: 1.75rem;
    font-weight: 500;
    color: #2b392a !important;
    letter-spacing: 0.5px;
    }

    .custom-nav-link {
    color: #2b392a !important;
    font-size: 1rem;
    font-weight: 500;
    padding: 6px 0 !important;
    transition: color 0.2s ease;
    }

    .custom-nav-link:hover {
    color: #8c7a6b !important;
    }

    .active-link {
    position: relative;
    }

    .active-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: #8c7a6b;
    }

    .nav-icon-btn {
    color: #2b392a;
    font-size: 1.35rem;
    transition: color 0.2s ease, transform 0.2s ease;
    }

    .nav-icon-btn:hover {
    color: #8c7a6b;
    transform: scale(1.05);
    }

    .no-caret::after, #notifDropdown::after {
    display: none !important;
    }

    @@media (max-width: 1199.98px) {
    .navbar-nav {
    padding: 20px 0;
    text-align: center;
    }

    .active-link::after {
    width: 30px;
    left: 50%;
    transform: translateX(-50%);
    }

    .h-icons-wrapper {
    justify-content: center;
    padding-top: 10px;
    }
    }
</style>