@model SmartHairSalonApp.Models.Usluga

@{
    ViewData["Title"] = "Brisanje Usluge";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-5" style="max-width: 600px;">
    <div class="mb-4 pb-2 border-bottom border-light">
        <h2 class="fw-bold text-uppercase tracking-wide" style="color: #dc3545; font-family: 'Playfair Display', serif;">Brisanje Usluge</h2>
        <p class="text-muted small text-uppercase tracking-wider m-0">Da li ste sigurni da želite trajno ukloniti ovu uslugu?</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div style="height: 4px; background: linear-gradient(90deg, #dc3545 0%, #ff6b6b 100%);"></div>

        <div class="card-body p-4">
            <div class="alert alert-danger border-0 rounded-3 d-flex align-items-center mb-4" style="background-color: #fff5f5; color: #c92a2a;">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                <span class="small fw-semibold">Pažnja: Ova akcija je nepovratna. Usluga će biti izbrisana iz cjenovnika salona.</span>
            </div>

            <div class="mb-3">
                <span class="text-muted text-uppercase tracking-wider d-block small mb-1">Naziv Usluge</span>
                <h4 class="fw-bold text-dark" style="font-family: 'Playfair Display', serif;">@Model.Naziv</h4>
            </div>

            <div class="mb-3">
                <span class="text-muted text-uppercase tracking-wider d-block small mb-1">Pripada Salonu</span>
                <p class="text-dark fw-semibold m-0">
                    <i class="bi bi-geo-alt-fill text-muted me-1"></i>
                    @(Model.Salon != null ? Model.Salon.Naziv : "Sve lokacije")
                </p>
            </div>

            <div class="mb-4 pt-3 border-top border-light">
                <span class="text-muted text-uppercase tracking-wider d-block small mb-0">Vrijednost / Cijena</span>
                <span class="fs-3 fw-extrabold text-dark">@Model.Cijena.ToString("0.00") <small class="fs-6 fw-semibold text-muted">KM</small></span>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between align-items-center pt-3 border-top border-light mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill text-uppercase btn-custom-outline">
                        Nazad na listu
                    </a>
                    <button type="submit" class="btn btn-danger px-4 rounded-pill text-uppercase btn-delete">
                        <i class="bi bi-trash3-fill me-2"></i>Potvrdi Brisanje
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .fw-extrabold {
        font-weight: 800;
    }

    .tracking-wide {
        letter-spacing: 0.05em;
    }

    .tracking-wider {
        letter-spacing: 0.1em;
    }

    .btn-custom-outline {
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 50px;
    }

    .btn-delete {
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 50px;
        transition: all 0.2s ease;
        background-color: #dc3545;
        border-color: #dc3545;
    }

        .btn-delete:hover {
            background-color: #b91c1c;
            border-color: #b91c1c;
            box-shadow: 0 4px 12px rgba(220, 53, 69, 0.2);
        }
</style>