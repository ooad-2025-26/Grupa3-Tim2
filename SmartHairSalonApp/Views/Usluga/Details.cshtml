@model SmartHairSalonApp.Models.Usluga

@{
    ViewData["Title"] = "Detalji Usluge";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-5" style="max-width: 600px;">
    <div class="mb-4 pb-2 border-bottom border-light">
        <h2 class="fw-bold text-uppercase tracking-wide" style="color: #1a1a1a; font-family: 'Playfair Display', serif;">Detalji Usluge</h2>
        <p class="text-muted small text-uppercase tracking-wider m-0">Pregled informacija o odabranom tretmanu</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div style="height: 4px; background: linear-gradient(90deg, #D4AF37 0%, #F3E5AB 100%);"></div>

        <div class="card-body p-4">
            <div class="mb-4">
                <span class="text-muted text-uppercase tracking-wider d-block small mb-1">Naziv tretmana</span>
                <h3 class="fw-bold text-dark" style="font-family: 'Playfair Display', serif;">@Model.Naziv</h3>
            </div>

            <div class="mb-4">
                <span class="text-muted text-uppercase tracking-wider d-block small mb-1">Lokacija / Salon</span>
                <p class="text-dark fw-semibold m-0">
                    <i class="bi bi-geo-alt-fill text-gold me-1"></i>
                    @(Model.Salon != null ? Model.Salon.Naziv : "Sve lokacije")
                </p>
            </div>

            <div class="mb-4 pt-3 border-top border-light">
                <span class="text-muted text-uppercase tracking-wider d-block small mb-0">Cijena usluge</span>
                <span class="fs-2 fw-extrabold text-dark">@Model.Cijena.ToString("0.00") <small class="fs-5 fw-semibold text-gold">KM</small></span>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-light mt-4">
                <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill text-uppercase btn-custom-outline">
                    Nazad na listu
                </a>
                @if (User.IsInRole("admin") || User.IsInRole("zaposlenik"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-dark px-4 rounded-pill text-uppercase btn-premium-dark">
                        Uredi uslugu
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: #D4AF37 !important;
    }

    .fw-extrabold {
        font-weight: 800;
    }

    .tracking-wide {
        letter-spacing: 0.05em;
    }

    .tracking-wider {
        letter-spacing: 0.1em;
    }

    .btn-premium-dark {
        background-color: #1a1a1a;
        border: 1px solid #1a1a1a;
        transition: all 0.25s ease;
        font-size: 0.8rem;
        font-weight: 600;
    }

        .btn-premium-dark:hover {
            background-color: #000000;
            border-color: #D4AF37;
        }

    .btn-custom-outline {
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 50px;
    }
</style>