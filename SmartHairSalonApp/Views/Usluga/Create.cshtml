@model SmartHairSalonApp.Models.Usluga

@{
    ViewData["Title"] = "Nova Usluga";
}

<div class="container my-5" style="max-width: 600px;">
    <div class="mb-4 pb-2 border-bottom border-light">
        <h2 class="fw-bold text-uppercase tracking-wide" style="color: #1a1a1a; font-family: 'Playfair Display', serif;">Nova Usluga</h2>
        <p class="text-muted small text-uppercase tracking-wider m-0">Kreirajte novi tretman i dodijelite mu cijenu</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div style="height: 4px; background: linear-gradient(90deg, #D4AF37 0%, #F3E5AB 100%);"></div>

        <div class="card-body p-4">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="form-group mb-4">
                    <label asp-for="Naziv" class="form-label text-muted text-uppercase tracking-wider small fw-semibold">Naziv Usluge</label>
                    <input asp-for="Naziv" class="form-control custom-input" placeholder="Npr. Muško šišanje, Feniranje, Pramenovi..." />
                    <span asp-validation-for="Naziv" class="text-danger small"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Cijena" class="form-label text-muted text-uppercase tracking-wider small fw-semibold">Cijena (KM)</label>
                    <input asp-for="Cijena" class="form-control custom-input" type="text" placeholder="0.00" />
                    <span asp-validation-for="Cijena" class="text-danger small"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="SalonId" class="form-label text-muted text-uppercase tracking-wider small fw-semibold">Dodijeli Salonu</label>
                    <select asp-for="SalonId" class="form-select custom-input" asp-items="ViewBag.SalonId">
                        <option value="">-- Izaberite salon --</option>
                    </select>
                    <span asp-validation-for="SalonId" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-3 border-top border-light mt-4">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill text-uppercase btn-custom-outline">
                        Odustani
                    </a>
                    <button type="submit" class="btn btn-dark px-4 rounded-pill text-uppercase btn-premium-dark">
                        Kreiraj Uslugu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .tracking-wide {
        letter-spacing: 0.05em;
    }

    .tracking-wider {
        letter-spacing: 0.1em;
    }

    .custom-input {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 10px 14px;
        font-size: 0.95rem;
        transition: all 0.2s ease;
    }

        .custom-input:focus {
            border-color: #D4AF37;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
            outline: none;
        }

    .btn-premium-dark {
        background-color: #1a1a1a;
        border: 1px solid #1a1a1a;
        transition: all 0.25s ease;
        font-size: 0.8rem;
        font-weight: 600;
    }

        .btn-premium-dark:hover {
            background-color: #000000;
            border-color: #D4AF37;
        }

    .btn-custom-outline {
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 50px;
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}