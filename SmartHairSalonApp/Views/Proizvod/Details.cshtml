@model SmartHairSalonApp.Models.Proizvod

@{
    ViewData["Title"] = Model.Naziv;
}

<div class="container-fluid bg-white flex-grow-1" style="min-height: 85vh;">
    <div class="container py-5">
        <div class="row mt-4">

            <div class="col-md-5 mb-4 text-center">
                <div class="p-4 border rounded-3 bg-light d-inline-block w-100" style="max-width: 450px;">
                    <img src="~/images/@(Model.Naziv.ToLower().Contains("šampon") ? "sampon.png" : "maska.png")"
                         alt="@Model.Naziv"
                         class="img-fluid"
                         onerror="this.src='/images/sampon.png';" />
                </div>
            </div>

            <div class="col-md-7 ps-md-5">
                <nav aria-label="breadcrumb" class="small text-muted mb-2">
                    Shop / @Model.Naziv
                </nav>

                <h1 class="display-5 fw-bold mb-3 text-dark" style="font-family: 'Plus Jakarta Sans', sans-serif;">
                    @Model.Naziv
                </h1>

                <h2 class="fw-bold mb-4" style="color: #0d6efd; font-family: 'Plus Jakarta Sans', sans-serif;">
                    @Model.Cijena.ToString("F2") KM
                </h2>

                <div class="mb-5">
                    <h6 class="fw-bold text-dark mb-2">Opis proizvoda:</h6>
                    <p class="text-muted small" style="line-height: 1.6; text-align: justify;">
                        @Model.Opis
                    </p>
                </div>

                <div class="d-flex gap-3 align-items-center">
                    <button onclick="dodajIzDetails(event, @Model.Id)" class="btn btn-primary fw-semibold px-4 py-2.5 d-flex align-items-center gap-2 shadow-sm" style="font-size: 1.05rem; border-radius: 6px;">
                        <i class="bi bi-cart3"></i> Dodaj u korpu
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary px-4 py-2.5 fw-medium" style="border-radius: 6px;">
                        Nazad
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function dodajIzDetails(event, id) {
            if (event) event.preventDefault();

            if (typeof window.dodajUKorpu === "function") {
                window.dodajUKorpu(id);
            } else {
                fetch(`/Proizvod/DodajUKorpu?id=${id}`, { method: 'POST' })
                    .then(res => res.json())
                    .then(data => {
                        window.location.href = '/Proizvod/Basket';
                    })
                    .catch(err => {
                        window.location.href = `/Proizvod/Basket`;
                    });
            }
        }
    </script>
}
