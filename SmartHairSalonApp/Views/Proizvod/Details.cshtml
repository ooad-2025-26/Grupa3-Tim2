@model SmartHairSalonApp.Models.Proizvod

@{
    ViewData["Title"] = Model.Naziv;
}

<div class="container py-5">
    <div class="card border-0 shadow rounded-3 p-4 p-md-5">
        <div class="row g-5">
            <div class="col-md-6 text-center">
                <img src="https://images.unsplash.com/photo-1608248597481-496100c8c836?q=80&w=600" class="img-fluid rounded-3 bg-light p-4" alt="@Model.Naziv" style="max-height: 400px; object-fit: contain;">
            </div>
            <div class="col-md-6 d-flex flex-column justify-content-center">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Shop</a></li>
                        <li class="breadcrumb-item active" aria-current="page">@Model.Naziv</li>
                    </ol>
                </nav>

                <h1 class="fw-bold text-dark display-5 mb-2">@Model.Naziv</h1>
                <div class="h3 fw-bold text-primary mb-4">@Model.Cijena.ToString("0.00") KM</div>

                <h5 class="fw-bold text-dark">Opis proizvoda:</h5>
                <p class="text-muted fs-6 mb-4 leading-relaxed">@Model.Opis</p>

                <div class="mb-4">
                    <span class="badge bg-light text-dark p-2 px-3 border fs-6">
                        <i class="bi bi-box-seam me-2"></i>Dostupna količina: <strong>@Model.Kolicina</strong>
                    </span>
                </div>

                <div class="d-flex gap-2">
                    <a asp-controller="Shop" asp-action="AddToCart" asp-route-id="@Model.Id" class="btn btn-primary btn-lg px-5 fw-bold shadow-sm @(Model.Kolicina <= 0 ? "disabled" : "")">
                        <i class="bi bi-cart-plus me-2"></i>Dodaj u korpu
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-lg px-4"><i class="bi bi-pencil-square"></i></a>
                    <a asp-action="Index" class="btn btn-light border btn-lg px-4">Nazad</a>
                </div>
            </div>
        </div>
    </div>
</div>