@model IEnumerable<SmartHairSalonApp.Models.Proizvod>

@{
    ViewData["Title"] = "Luxury Haircare Shop";
    bool jeOsoblje = User.IsInRole("admin") || User.IsInRole("Admin") || User.IsInRole("zaposlenik") || User.IsInRole("Zaposlenik");
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container py-5">
    <div class="text-center mb-5 font-luxury">
        <span class="text-uppercase tracking-widest text-gold fw-bold small d-block mb-2">Ekskluzivna Njega Kose</span>
        <h1 class="display-5 fw-bold font-serif text-dark mt-1">Naš profesionalni shop</h1>
        <div class="mx-auto my-3 bg-gold-gradient" style="width: 60px; height: 2px;"></div>
        <p class="text-muted mx-auto small mb-2" style="max-width: 550px;">
            Vrhunski <strong>Kérastase Paris</strong> proizvodi. Rezervišite artikle online i preuzmite ih u našem salonu.
        </p>
    </div>

    @if (jeOsoblje)
    {
        <div class="alert border-0 p-4 mb-5 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 shadow-sm rounded-4 bg-white position-relative overflow-hidden">
            <div style="position: absolute; top: 0; left: 0; bottom: 0; width: 4px; background: linear-gradient(180deg, #D4AF37 0%, #F3E5AB 100%);"></div>
            <div>
                <h6 class="fw-bold mb-1 text-dark text-uppercase tracking-wider small"><i class="bi bi-sliders text-gold me-2"></i>Upravljanje Proizvodima</h6>
                <p class="text-muted small mb-0">Dodavanje, ažuriranje ili brisanje artikala iz ponude.</p>
            </div>
            <a href="/Proizvod/Create" class="btn btn-premium-dark btn-sm rounded-pill px-4 py-2 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Dodaj Novi Proizvod
            </a>
        </div>
    }

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @{
            int brojacSlike = 1;
        }
        @foreach (var proizvod in Model)
        {
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white position-relative transition-card p-3">

                    @if (proizvod.Kolicina <= 0)
                    {
                        <span class="badge bg-danger position-absolute top-0 end-0 m-4 px-3 py-2 text-uppercase fw-bold shadow-sm" style="letter-spacing: 0.5px; z-index: 5; font-size: 0.7rem; border-radius: 4px;">Rasprodano</span>
                    }
                    else if (proizvod.Kolicina < 5)
                    {
                        <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-4 px-3 py-2 text-uppercase fw-bold shadow-sm" style="letter-spacing: 0.5px; z-index: 5; font-size: 0.7rem; border-radius: 4px;">Zadnji komadi</span>
                    }

                    <div class="d-flex align-items-center justify-content-center rounded-3 bg-light overflow-hidden" style="height: 260px; border: 1px solid #f1f1ef;">
                        <img src="@Url.Content("~/images/proizvod" + brojacSlike + ".jpg")" alt="@proizvod.Naziv" class="img-fluid p-3" style="max-height: 100%; object-fit: contain; transition: transform 0.5s ease;" />
                    </div>

                    <div class="card-body px-1 pt-4 pb-2 d-flex flex-column">
                        <span class="text-uppercase tracking-widest text-gold fw-bold d-block mb-1" style="font-size: 0.75rem;">Kérastase Paris</span>
                        <h4 class="card-title fw-bold font-serif text-dark mb-2 h5">@proizvod.Naziv</h4>
                        <p class="card-text text-muted small flex-grow-1 text-truncate-2">
                            @proizvod.Opis
                        </p>

                        <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top border-light">
                            <div>
                                <span class="text-muted d-block text-uppercase tracking-wider" style="font-size: 0.65rem; font-weight: 600;">Cijena</span>
                                <span class="fs-4 fw-bold text-dark font-serif">@proizvod.Cijena.ToString("F2") <small class="text-muted fw-normal" style="font-size: 0.8rem; font-family: sans-serif;">KM</small></span>
                            </div>

                            <div class="d-flex gap-2">
                                <a href="/Proizvod/Details/@proizvod.Id" class="btn btn-premium-outline btn-sm px-3 py-2 rounded-3" title="Detalji">
                                    <i class="bi bi-eye"></i>
                                </a>

                                @if (!jeOsoblje && proizvod.Kolicina > 0)
                                {
                                    <button onclick="dodajUKorpuPrekoAjaxa(@proizvod.Id)" class="btn btn-premium-dark btn-sm px-3 py-2 rounded-3">
                                        <i class="bi bi-cart-plus me-1"></i> Kupi
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    @if (jeOsoblje)
                    {
                        <div class="card-footer bg-transparent border-top border-light pt-3 px-1 pb-0 d-flex justify-content-around" style="font-size: 0.85rem;">
                            <a href="/Proizvod/Edit/@proizvod.Id" class="text-decoration-none fw-semibold text-warning transition-link"><i class="bi bi-pencil-square me-1"></i> Uredi</a>
                            <div class="text-muted opacity-50">|</div>
                            <a href="/Proizvod/Delete/@proizvod.Id" class="text-decoration-none fw-semibold text-danger transition-link"><i class="bi bi-trash3 me-1"></i> Obriši</a>
                        </div>
                    }
                </div>
            </div>

            brojacSlike++;
        }
    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .text-gold {
        color: #D4AF37 !important;
    }

    .bg-gold-gradient {
        background: linear-gradient(90deg, #D4AF37 0%, #F3E5AB 100%) !important;
    }

    .tracking-widest {
        letter-spacing: 3px !important;
    }

    .tracking-wider {
        letter-spacing: 0.1em !important;
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.5;
    }

    .transition-card {
        transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

        .transition-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 12px 24px rgba(26,26,26,0.06) !important;
        }

            .transition-card:hover img {
                transform: scale(1.04);
            }

    .transition-link {
        transition: opacity 0.2s ease;
    }

        .transition-link:hover {
            opacity: 0.8;
        }
</style>

@section Scripts {
    @if (!jeOsoblje)
    {
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            function dodajUKorpuPrekoAjaxa(id) {
            fetch(`/Proizvod/DodajUKorpu?id=${id}`, { method: 'POST' })
            .then(res => res.json())
            .then(data => {
            if (typeof azurirajBadgeKorpe === "function") {
            azurirajBadgeKorpe(data);
            } else {
            let brojac = document.getElementById('brojac-proizvoda');
            let ukupnoArtikala = 0;
            if (Array.isArray(data)) {
            data.forEach(item => {
            ukupnoArtikala += (item.kolicina || item.Kolicina || 0);
            });
            }
            if (brojac) {
            brojac.innerText = ukupnoArtikala;
            }
            }

            const Toast = Swal.mixin({
            toast: true,
            position: 'bottom-end',
            showConfirmButton: false,
            timer: 2000,
            timerProgressBar: true
            });
            Toast.fire({
            icon: 'success',
            title: 'Proizvod dodan u vašu beauty korpu!'
            });
            })
            .catch(err => console.error("Greška:", err));
            }
        </script>
    }
}