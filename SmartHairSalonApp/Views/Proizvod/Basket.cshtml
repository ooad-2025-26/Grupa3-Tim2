@model SmartHairSalonApp.Controllers.KorpaObracunViewModel

@{
    ViewData["Title"] = "Vaša Kozmetička Korpa";
    bool jeOsoblje = User.IsInRole("admin") || User.IsInRole("Admin") || User.IsInRole("zaposlenik") || User.IsInRole("Zaposlenik");
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-5" style="min-height: 80vh;">

    @if (jeOsoblje)
    {
        <div class="row justify-content-center mt-5">
            <div class="col-md-6 text-center">
                <div class="card border-0 shadow-sm p-5 rounded-4 bg-white position-relative overflow-hidden">
                    <div style="height: 4px; background: linear-gradient(90deg, #D4AF37 0%, #F3E5AB 100%); position: absolute; top: 0; left: 0; right: 0;"></div>

                    <i class="bi bi-shield-lock text-gold mb-4" style="font-size: 4rem;"></i>
                    <h2 class="fw-bold text-uppercase tracking-wide mb-3 text-dark" style="font-family: 'Playfair Display', serif; font-size: 1.5rem;">Pristup samo za menadžment</h2>
                    <p class="text-muted mb-4 small text-uppercase tracking-wider">
                        Kao administrator ili zaposlenik salona, nemate mogućnost kreiranja narudžbi i korištenja potrošačke korpe. Vaš račun služi isključivo za upravljanje proizvodima i salonom.
                    </p>
                    <a href="/Proizvod/Index" class="btn btn-dark px-4 py-3 rounded-pill text-uppercase btn-premium-dark shadow-sm">
                        <i class="bi bi-arrow-left me-2"></i> Nazad na Upravljanje Shopom
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Model.PoklonPoruka))
        {
            <div class="card border-0 shadow-sm p-4 mb-5 rounded-4 text-center bg-white position-relative overflow-hidden">
                <div style="width: 4px; background: linear-gradient(180deg, #D4AF37 0%, #F3E5AB 100%); position: absolute; left: 0; top: 0; bottom: 0;"></div>
                <div class="card-body py-2">
                    <i class="bi bi-gift text-gold fs-2 d-block mb-2"></i>
                    <h5 class="fw-bold text-uppercase tracking-wide mb-1 text-dark" style="font-family: 'Playfair Display', serif;">Premium Nagrada za Lojalnost!</h5>
                    <p class="mb-0 text-muted small text-uppercase tracking-wider">@Model.PoklonPoruka</p>
                </div>
            </div>
        }

        <div class="row g-5 align-items-start">
            <div class="col-lg-5 col-md-12">
                <span class="text-uppercase tracking-widest text-gold fw-bold small d-block mb-2">Vaš Izbor</span>
                <h1 class="fw-bold text-uppercase tracking-wide display-5 mb-4 text-dark" style="font-family: 'Playfair Display', serif;">
                    Vaša Korpa Ljepote
                </h1>
                <div class="gold-divider mb-4"></div>

                <p class="text-secondary mb-3 justify-text" style="font-size: 1.05rem;">
                    S ponosom vam nudimo <strong>Kérastase Paris</strong>, profesionalnu luksuznu njegu kose kojoj vjeruju stručnjaci širom svijeta.
                </p>
                <p class="text-muted small text-uppercase tracking-wider mb-4 justify-text">
                    Automatski obračunavamo količinske popuste za artikle u vašoj korpi.
                </p>

                <div class="p-3 rounded-4 border border-light bg-light mb-5 d-flex align-items-center gap-3">
                    <i class="bi bi-shop text-gold fs-4"></i>
                    <p class="fw-semibold text-uppercase tracking-wide font-xs text-dark m-0">
                        Svi naručeni proizvodi će vas čekati spremni za preuzimanje u našem salonu!
                    </p>
                </div>

                <div class="d-grid">
                    <button onclick="zavrsiNarudzbu()" class="btn btn-dark py-3 rounded-pill text-uppercase btn-premium-dark shadow-sm">
                        ZAKLJUČI NARUDŽBU
                    </button>
                </div>
            </div>

            <div class="col-lg-7 col-md-12">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
                    <div style="height: 4px; background: linear-gradient(90deg, #D4AF37 0%, #F3E5AB 100%);"></div>

                    <div class="table-responsive">
                        <table class="table mb-0 align-middle custom-table">
                            <thead class="table-light text-uppercase tracking-wider small">
                                <tr>
                                    <th class="py-3 px-4">Naziv proizvoda i količina</th>
                                    <th class="py-3 px-4 text-end pe-4">Cijena</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Stavke == null || !Model.Stavke.Any())
                                {
                                    <tr>
                                        <td colspan="2" class="text-center py-5">
                                            <i class="bi bi-cart-x text-muted d-block mb-2" style="font-size: 2.5rem;"></i>
                                            <span class="text-muted text-uppercase tracking-wider small">Vaša kozmetička korpa je trenutno prazna.</span>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var stavka in Model.Stavke)
                                    {
                                        <tr>
                                            <td class="py-4 px-4">
                                                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                                    <div>
                                                        <span class="fw-bold text-dark fs-6 d-block" style="font-family: 'Playfair Display', serif;">@stavka.Naziv</span>
                                                        <span class="text-muted font-xs text-uppercase tracking-wide d-block mt-1">Komad: @stavka.Cijena.ToString("F2") KM</span>

                                                        @if (stavka.PopustProcenat > 0)
                                                        {
                                                            <div class="mt-2">
                                                                <span class="badge bg-gold-light text-gold text-uppercase px-2 py-1 font-xs tracking-wide">
                                                                    <i class="bi bi-percent me-1"></i>Količinski popust od @stavka.PopustProcenat% uračunat!
                                                                </span>
                                                            </div>
                                                        }
                                                    </div>

                                                    <div class="d-flex align-items-center gap-2 bg-light rounded-pill p-1 border border-light">
                                                        <button class="btn btn-sm btn-white rounded-circle p-0 d-flex align-items-center justify-content-center btn-qty" onclick="promijeniKolicinu(@stavka.ProizvodId, -1)">-</button>
                                                        <span class="fw-bold text-dark px-1 font-xs">@stavka.Kolicina</span>
                                                        <button class="btn btn-sm btn-white rounded-circle p-0 d-flex align-items-center justify-content-center btn-qty" onclick="promijeniKolicinu(@stavka.ProizvodId, 1)">+</button>

                                                        <button class="btn btn-sm text-muted btn-trash ms-1 me-1" onclick="ukloniIzKorpe(@stavka.ProizvodId)" title="Ukloni artikl">
                                                            <i class="bi bi-trash3 text-danger"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-4 px-4 text-end pe-4 fw-bold text-dark">
                                                @if (stavka.PopustProcenat > 0)
                                                {
                                                    <span class="text-decoration-line-through text-muted small font-xs d-block mb-1">@((stavka.Cijena * stavka.Kolicina).ToString("F2")) KM</span>
                                                    <span class="text-gold">@stavka.UkupnoStavka.ToString("F2") KM</span>
                                                }
                                                else
                                                {
                                                    <span>@stavka.UkupnoStavka.ToString("F2") KM</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }

                                <tr class="table-light text-uppercase tracking-wider font-xs">
                                    <td class="py-3 px-4 text-muted">Međuzbir stavki:</td>
                                    <td class="py-3 px-4 text-end pe-4 text-muted fw-semibold">@Model.SubTotal.ToString("F2") KM</td>
                                </tr>
                                <tr class="table-light text-uppercase tracking-wider font-xs">
                                    <td class="py-3 px-4 text-gold">Ušteđeno kroz popust:</td>
                                    <td class="py-3 px-4 text-end pe-4 text-gold fw-bold">- @Model.UkupniPopust.ToString("F2") KM</td>
                                </tr>
                                <tr class="table-light border-bottom text-uppercase tracking-wider font-xs">
                                    <td class="py-3 px-4 text-muted">Preuzimanje:</td>
                                    <td class="py-3 px-4 text-end pe-4 fw-bold text-dark">Lično u salonu (0.00 KM)</td>
                                </tr>

                                <tr style="background-color: #faf9f6; border-top: 2px solid #eaddbd;">
                                    <td class="py-4 px-4 fw-bold text-dark tracking-wide text-uppercase" style="font-family: 'Playfair Display', serif; font-size: 1.1rem;">UKUPNO :</td>
                                    <td class="py-4 px-4 fw-bold text-dark text-end pe-4" style="font-size: 1.15rem;">
                                        @Model.Total.ToString("F2") KM
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .text-gold {
        color: #D4AF37 !important;
    }

    .bg-gold-light {
        background-color: #fdfaf2;
        border: 1px solid #f3ebd3;
    }

    .tracking-wide {
        letter-spacing: 0.05em;
    }

    .tracking-wider {
        letter-spacing: 0.1em;
    }

    .tracking-widest {
        letter-spacing: 0.2em;
    }

    .font-xs {
        font-size: 0.7rem;
        font-weight: 600;
    }

    .justify-text {
        text-align: justify;
    }

    .gold-divider {
        height: 2px;
        width: 60px;
        background: linear-gradient(90deg, #D4AF37 0%, #F3E5AB 100%);
    }

    /* Tabela */
    .custom-table th {
        background-color: #fafafa;
        border-bottom: 1px solid #f1f1ef;
        padding: 14px 12px;
        color: #666;
        font-size: 0.75rem;
    }

    .custom-table td {
        border-bottom: 1px solid #f8f9fa;
    }

    /* Premium gumbi */
    .btn-premium-dark {
        background-color: #1a1a1a;
        border: 1px solid #1a1a1a;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        transition: all 0.25s ease;
    }

        .btn-premium-dark:hover {
            background-color: #000000;
            border-color: #D4AF37;
            color: #D4AF37 !important;
        }

    .btn-white {
        background-color: #ffffff;
        border: none;
    }

        .btn-white:hover {
            background-color: #eaeaea;
        }

    .btn-qty {
        width: 24px;
        height: 24px;
        font-weight: bold;
        font-size: 0.8rem;
    }

    .btn-trash {
        background: none;
        border: none;
        padding: 0 4px;
    }

        .btn-trash:hover {
            opacity: 0.7;
        }
</style>

@section Scripts {
    @if (!jeOsoblje)
    {
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            function promijeniKolicinu(id, promjena) {
            fetch(`/Proizvod/PromijeniKolicinu?id=${id}&promjena=${promjena}`, { method: 'POST' })
            .then(() => {
            window.location.reload();
            });
            }

            function ukloniIzKorpe(id) {
            fetch(`/Proizvod/UkloniIzKorpe?id=${id}`, { method: 'POST' })
            .then(() => {
            window.location.reload();
            });
            }

            function zavrsiNarudzbu() {
            fetch('/Proizvod/ZavrsiNarudzbu', {
            method: 'POST'
            })
            .then(res => res.json())
            .then(data => {
            if (data.success) {
            Swal.fire({
            title: 'Hvala vam!',
            text: data.message,
            icon: 'success',
            confirmButtonColor: '#1a1a1a',
            confirmButtonText: 'Nazad na Shop'
            }).then(() => {
            window.location.href = '/Proizvod/Index';
            });
            } else if (data.redirectUrl) {
            Swal.fire({
            title: 'Potrebna prijava',
            text: 'Morate biti prijavljeni na sistem da biste završili narudžbu.',
            icon: 'info',
            confirmButtonColor: '#1a1a1a',
            confirmButtonText: 'Idi na prijavu'
            }).then(() => {
            window.location.href = data.redirectUrl;
            });
            } else {
            Swal.fire({
            title: 'Greška',
            text: data.message,
            icon: 'error',
            confirmButtonColor: '#d33'
            });
            }
            })
            .catch(err => {
            console.error("Greška prilikom narudžbe:", err);
            Swal.fire({
            title: 'Greška',
            text: 'Nešto je pošlo po zlu. Molimo pokušajte ponovo.',
            icon: 'error',
            confirmButtonColor: '#d33'
            });
            });
            }
        </script>
    }
}