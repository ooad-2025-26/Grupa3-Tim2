@model SmartHairSalonApp.Controllers.KorpaObracunViewModel

@{
    ViewData["Title"] = "Your Beauty Basket";
    bool jeOsoblje = User.IsInRole("admin") || User.IsInRole("Admin") || User.IsInRole("zaposlenik") || User.IsInRole("Zaposlenik");
}

<div class="container py-5" style="min-height: 80vh;">

    @if (jeOsoblje)
    {
        <div class="row justify-content-center mt-5">
            <div class="col-md-6 text-center">
                <div class="card border-0 shadow-sm p-5" style="border-radius: 16px; background-color: #fbfbfa;">
                    <i class="bi bi-shield-lock-fill text-warning mb-4" style="font-size: 4rem;"></i>
                    <h2 class="fw-bold mb-3" style="color: #2b3a22; font-family: 'Playfair Display', serif;">Management Access Only</h2>
                    <p class="text-muted mb-4 fs-5" style="font-family: 'Plus Jakarta Sans', sans-serif;">
                        Kao administrator ili zaposlenik salona, nemate mogućnost kreiranja narudžbi i korištenja potrošačke korpe. Vaš račun služi isključivo za upravljanje proizvodima i salonom.
                    </p>
                    <a href="/Proizvod/Index" class="btn text-white fw-bold px-4 py-3 shadow-sm" style="background-color: #2b3a22; border-radius: 4px; letter-spacing: 0.5px;">
                        <i class="bi bi-arrow-left me-2"></i> Nazad na Upravljanje Shopom
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Model.PoklonPoruka))
        {
            <div class="alert alert-warning border-0 shadow-sm p-4 mb-4 text-center text-dark" style="background-color: #f4efe6; border-left: 5px solid #2b3a22 !important; border-radius: 4px;">
                <i class="bi bi-gift-fill text-success fs-3 d-block mb-2"></i>
                <h5 class="fw-bold mb-1" style="font-family: 'Playfair Display', serif;">Premium Loyalty Reward!</h5>
                <p class="mb-0 small fw-medium text-muted">@Model.PoklonPoruka</p>
            </div>
        }

        <div class="row align-items-center mt-4">

            <div class="col-md-6 mb-5 mb-md-0">
                <h1 class="display-4 fw-bold mb-4" style="color: #2b3a22; font-family: 'Playfair Display', serif;">
                    Your Beauty Basket
                </h1>
                <p class="lead text-muted fs-5 mb-3">
                    We proudly offer Kérastase, professional luxury haircare trusted by experts worldwide.
                </p>
                <p class="text-muted mb-3 fs-5">
                    Our dynamic loyalty algorithm automatically calculates bulk discounts for items in your basket.
                </p>
                <p class="fw-semibold fs-5 mb-5" style="color: #2b3a22;">
                    All ordered products will be waiting for you at our salon!
                </p>

                <button onclick="zavrsiNarudzbu()" class="btn px-5 py-3 text-white fw-bold shadow-sm"
                        style="background-color: #2b3a22; border-radius: 4px; letter-spacing: 1px;">
                    PLACE ORDER
                </button>
            </div>

            <div class="col-md-6">
                <div class="card border-0 shadow-sm" style="border-radius: 0px;">
                    <div class="table-responsive">
                        <table class="table mb-0 align-middle">
                            <thead style="background-color: #e9e6e1;">
                                <tr>
                                    <th class="py-3 px-4 text-secondary" style="font-weight: 500; font-family: 'Plus Jakarta Sans', sans-serif;">Product name + quantity</th>
                                    <th class="py-3 px-4 text-secondary text-end" style="font-weight: 500; font-family: 'Plus Jakarta Sans', sans-serif;">Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Stavke == null || !Model.Stavke.Any())
                                {
                                    <tr>
                                        <td colspan="2" class="text-center py-5 text-muted" style="font-family: 'Plus Jakarta Sans', sans-serif;">
                                            <i class="bi bi-cart-x d-block fs-3 mb-2"></i>
                                            Vaša kozmetička korpa je trenutno prazna.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var stavka in Model.Stavke)
                                    {
                                        <tr style="border-bottom: 1px solid #f2effa;">
                                            <td class="py-4 px-4 fw-medium text-dark" style="font-family: 'Plus Jakarta Sans', sans-serif;">
                                                <div class="d-flex align-items-center justify-content-between">
                                                    <div>
                                                        <span class="fw-bold fs-5">@stavka.Naziv</span>
                                                        <div class="text-muted small mt-1">Komad: @stavka.Cijena.ToString("F2") KM</div>

                                                        @if (stavka.PopustProcenat > 0)
                                                        {
                                                            <div class="mt-1">
                                                                <span class="badge bg-success" style="font-size: 0.75rem;"><i class="bi bi-percent me-1"></i>Količinski popust od @stavka.PopustProcenat% uračunat!</span>
                                                            </div>
                                                        }
                                                    </div>

                                                    <div class="d-flex align-items-center gap-2 ms-3">
                                                        <button class="btn btn-sm btn-light py-0 px-2 border" onclick="promijeniKolicinu(@stavka.ProizvodId, -1)">-</button>
                                                        <span class="fw-bold bg-light px-2 py-1 rounded" style="font-size: 0.85rem;">@stavka.Kolicina</span>
                                                        <button class="btn btn-sm btn-light py-0 px-2 border" onclick="promijeniKolicinu(@stavka.ProizvodId, 1)">+</button>
                                                        <button class="btn btn-sm text-danger ms-1" onclick="ukloniIzKorpe(@stavka.ProizvodId)" title="Ukloni artikl">
                                                            <i class="bi bi-trash3"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="py-4 px-4 fw-semibold text-dark text-end" style="font-family: 'Plus Jakarta Sans', sans-serif;">
                                                @if (stavka.PopustProcenat > 0)
                                                {
                                                    <span class="text-decoration-line-through text-muted small d-block" style="font-size: 0.8rem;">@((stavka.Cijena * stavka.Kolicina).ToString("F2")) KM</span>
                                                    <span class="text-success">@stavka.UkupnoStavka.ToString("F2") KM</span>
                                                }
                                                else
                                                {
                                                    <span>@stavka.UkupnoStavka.ToString("F2") KM</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }

                                <tr class="table-light">
                                    <td class="py-2 px-4 text-muted small" style="font-family: 'Plus Jakarta Sans', sans-serif;">Međuzbir stavki:</td>
                                    <td class="py-2 px-4 text-end text-muted small fw-medium" style="font-family: 'Plus Jakarta Sans', sans-serif;">@Model.SubTotal.ToString("F2") KM</td>
                                </tr>
                                <tr class="table-light">
                                    <td class="py-2 px-4 text-success small" style="font-family: 'Plus Jakarta Sans', sans-serif;">Ušteđeno kroz popust:</td>
                                    <td class="py-2 px-4 text-end text-success small fw-bold" style="font-family: 'Plus Jakarta Sans', sans-serif;">- @Model.UkupniPopust.ToString("F2") KM</td>
                                </tr>
                                <tr class="table-light border-bottom">
                                    <td class="py-2 px-4 text-muted small" style="font-family: 'Plus Jakarta Sans', sans-serif;">Preuzimanje:</td>
                                    <td class="py-2 px-4 text-end small fw-bold text-primary" style="font-family: 'Plus Jakarta Sans', sans-serif;">Lično u salonu (0.00 KM)</td>
                                </tr>

                                <tr style="background-color: #ded9d2; border-top: 2px solid #c9c2ba;">
                                    <td class="py-4 px-4 fw-bold text-dark" style="font-family: 'Plus Jakarta Sans', sans-serif; letter-spacing: 0.5px;">TOTAL :</td>
                                    <td class="py-4 px-4 fw-bold text-dark text-end" style="font-family: 'Plus Jakarta Sans', sans-serif;">
                                        @Model.Total.ToString("F2") KM
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    }
</div>

@section Scripts {
    @if (!jeOsoblje)
    {
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            function promijeniKolicinu(id, promjena) {
            fetch(`/Proizvod/PromijeniKolicinu?id=${id}&promjena=${promjena}`, { method: 'POST' })
            .then(() => {
            window.location.reload();
            });
            }

            function ukloniIzKorpe(id) {
            fetch(`/Proizvod/UkloniIzKorpe?id=${id}`, { method: 'POST' })
            .then(() => {
            window.location.reload();
            });
            }

            function zavrsiNarudzbu() {
            fetch('/Proizvod/ZavrsiNarudzbu', {
            method: 'POST'
            })
            .then(res => res.json())
            .then(data => {
            if (data.success) {
            Swal.fire({
            title: 'Thank you!',
            text: data.message, // Automatski ispisuje našu novu poruku o salonu sa servera
            icon: 'success',
            confirmButtonColor: '#2b3a22',
            confirmButtonText: 'Back to Shop'
            }).then(() => {
            window.location.href = '/Proizvod/Index';
            });
            } else if (data.redirectUrl) {
            Swal.fire({
            title: 'Login Required',
            text: 'You need to be logged in to place an order.',
            icon: 'info',
            confirmButtonColor: '#2b3a22',
            confirmButtonText: 'Go to Login'
            }).then(() => {
            window.location.href = data.redirectUrl;
            });
            } else {
            Swal.fire({
            title: 'Error',
            text: data.message,
            icon: 'error',
            confirmButtonColor: '#d33'
            });
            }
            })
            .catch(err => {
            console.error("Greška prilikom narudžbe:", err);
            Swal.fire({
            title: 'Error',
            text: 'Something went wrong. Please try again.',
            icon: 'error',
            confirmButtonColor: '#d33'
            });
            });
            }
        </script>
    }
}