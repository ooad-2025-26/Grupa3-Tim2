@model SmartHairSalonApp.Models.Proizvod

@{
    ViewData["Title"] = "Novi Proizvod";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow rounded-3">
                <div class="card-body p-5">
                    <h2 class="card-title fw-bold text-dark mb-4 text-center">Dodaj Novi Proizvod</h2>
                    <hr class="mb-4">

                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Naziv" class="form-label fw-semibold"></label>
                            <input asp-for="Naziv" class="form-control form-control-lg" placeholder="Unesite naziv proizvoda" />
                            <span asp-validation-for="Naziv" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Cijena" class="form-label fw-semibold">Cijena (KM)</label>
                                <input asp-for="Cijena" class="form-control form-control-lg" type="number" step="0.01" placeholder="0.00" />
                                <span asp-validation-for="Cijena" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Kolicina" class="form-label fw-semibold">Količina na stanju</label>
                                <input asp-for="Kolicina" class="form-control form-control-lg" type="number" placeholder="0" />
                                <span asp-validation-for="Kolicina" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Opis" class="form-label fw-semibold"></label>
                            <textarea asp-for="Opis" class="form-control" rows="4" placeholder="Kratak opis proizvoda i način upotrebe..."></textarea>
                            <span asp-validation-for="Opis" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm">Spremi Proizvod</button>
                            <a asp-action="Index" class="btn btn-light btn-lg border fw-semibold">Nazad na listu</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}