@{
    ViewData["Title"] = "Početna";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

@if (TempData["SuccessMessage"] != null)
{
    <div class="container mt-4">
        <div class="alert alert-success border-0 shadow-sm rounded-3 small" style="background-color: #fcf9f2; color: #b89728; border: 1px solid #eaddbd !important;">
            @TempData["SuccessMessage"]
        </div>
    </div>
}

<div class="hero-container position-relative overflow-hidden">
    <div class="container h-100">
        <div class="row h-100 align-items-center">

            <div class="col-lg-6 col-12 text-section pe-lg-5">
                <span class="text-uppercase tracking-widest text-gold fw-bold d-block mb-3 brand-header-lead">
                    Smart Hair Salon & Premium Shop
                </span>
                <h1 class="hero-title fw-bold mb-4">
                    Otkrijte novu dimenziju luksuza i zdravlja vaše kose.
                </h1>
                <p class="hero-subtitle mb-4">
                    Dobrodošli u oazu u kojoj se vaša ljepota, autentičan stil i vrhunska briga o sebi spajaju u jedinstveno iskustvo.
                    Rezervišite svoj termin ili istražite našu selekciju premium proizvoda za njegu kose kreiranih samo za vas.
                </p>
                <p class="hero-motto fw-semibold text-uppercase tracking-wider mb-5">
                    Jer sjajan dan za kosu mijenja sve
                </p>

                <div class="d-flex flex-wrap gap-3 structure-buttons">
                    <a asp-controller="Rezervacija" asp-action="Create" class="btn btn-book-now text-uppercase fw-semibold rounded-pill shadow-sm">
                        Rezerviši termin
                    </a>
                    <a asp-controller="Proizvod" asp-action="Index" class="btn btn-shop-now text-uppercase fw-semibold rounded-pill shadow-sm">
                        Posjeti shop
                    </a>
                </div>
            </div>

            <div class="col-lg-6 col-12 position-relative image-section mt-5 mt-lg-0 d-flex justify-content-end align-items-center" style="min-height: 600px;">

                <div class="main-image-wrapper shadow-lg">
                    <img src="@Url.Content("~/images/home-hero.jpg")" alt="Smart Hair Salon" class="img-fluid main-img" />
                </div>

                <div class="circle-image-wrapper shadow-lg d-none d-sm-block">
                    <img src="@Url.Content("~/images/home-products.jpg")" alt="Premium Haircare" class="circle-img" />
                </div>

            </div>
        </div>
    </div>
</div>

<div class="container pb-5 mt-4 mt-lg-2">
    <div class="row justify-content-start">
        <div class="col-lg-8 col-12">
            <div class="features-card border-0 shadow-sm p-4 rounded-4 bg-white position-relative overflow-hidden">
                <div class="features-gold-bar"></div>
                <div class="d-flex align-items-start gap-4 flex-column flex-sm-row">
                    <div class="feature-badge-icon flex-shrink-0 pt-1">
                        <i class="bi bi-shield-check text-gold" style="font-size: 3.5rem;"></i>
                    </div>
                    <div class="flex-grow-1">
                        <h6 class="fw-bold text-center text-sm-start mb-3 text-uppercase tracking-widest text-dark small">
                            Vaša rutina ljepote, pojednostavljena
                        </h6>
                        <div class="row g-3 text-muted small">
                            <div class="col-sm-6 col-12 d-flex align-items-center">
                                <i class="bi bi-circle-fill text-gold me-2" style="font-size: 0.4rem;"></i> Laka i brza rezervacija termina
                            </div>
                            <div class="col-sm-6 col-12 d-flex align-items-center">
                                <i class="bi bi-circle-fill text-gold me-2" style="font-size: 0.4rem;"></i> Premium proizvodi za kućnu njegu
                            </div>
                            <div class="col-sm-6 col-12 d-flex align-items-center">
                                <i class="bi bi-circle-fill text-gold me-2" style="font-size: 0.4rem;"></i> Profesionalne i moderne salonske usluge
                            </div>
                            <div class="col-sm-6 col-12 d-flex align-items-center">
                                <i class="bi bi-circle-fill text-gold me-2" style="font-size: 0.4rem;"></i> Ekskluzivan ambijent na prepoznatljivoj lokaciji
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Luksuzna, mirna pozadina visokog kontrasta */
    body {
        background: #fdfdfb !important;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    .hero-container {
        min-height: 80vh;
        padding: 80px 0;
    }

    /* Zlatni akcenat */
    .text-gold {
        color: #D4AF37 !important;
    }

    /* 🔥 POVEĆANO: Stil za glavno ime salona iznad naslova */
    .brand-header-lead {
        font-size: 1.15rem;
        letter-spacing: 0.22em;
    }

    /* Glavni naslov sa Playfair Display fontom */
    .hero-title {
        color: #1a1a1a;
        font-family: 'Playfair Display', serif;
        font-size: 3.6rem;
        line-height: 1.25;
        letter-spacing: -0.5px;
    }

    /* Podnaslov i profinjeni moto */
    .hero-subtitle {
        color: #666666;
        font-size: 1.15rem;
        line-height: 1.7;
    }

    .hero-motto {
        color: #1a1a1a;
        font-size: 0.85rem;
        letter-spacing: 0.15em;
        position: relative;
        display: inline-block;
    }

        .hero-motto::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 0;
            width: 40px;
            height: 2px;
            background-color: #D4AF37;
        }

    /* Dugme: REZERVIŠI TERMIN */
    .btn-book-now {
        background-color: #1a1a1a;
        color: #ffffff !important;
        border: 1px solid #1a1a1a;
        padding: 15px 36px;
        font-size: 0.85rem;
        letter-spacing: 0.1em;
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

        .btn-book-now:hover {
            background-color: #000000;
            border-color: #D4AF37;
            transform: translateY(-3px);
            box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1) !important;
        }

    /* Dugme: POSJETI SHOP */
    .btn-shop-now {
        background-color: #ffffff;
        color: #1a1a1a !important;
        border: 1px solid #e2e8f0;
        padding: 15px 36px;
        font-size: 0.85rem;
        letter-spacing: 0.1em;
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

        .btn-shop-now:hover {
            border-color: #D4AF37;
            color: #D4AF37 !important;
            transform: translateY(-3px);
            box-shadow: 0 8px 15px rgba(212, 175, 55, 0.08) !important;
        }

    /* Slike */
    .main-image-wrapper {
        width: 100%;
        max-width: 560px;
        height: 540px;
        border-radius: 30% 70% 40% 60% / 40% 30% 70% 60%;
        overflow: hidden;
        margin-left: auto;
        position: relative;
        z-index: 1;
        border: 1px solid rgba(212, 175, 55, 0.1);
    }

    .main-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    .circle-image-wrapper {
        position: absolute;
        width: 310px;
        height: 310px;
        border-radius: 50%;
        overflow: hidden;
        top: 40px;
        left: -30px;
        border: 10px solid #ffffff;
        box-shadow: 0 15px 35px rgba(0,0,0,0.12) !important;
        z-index: 10;
    }

        .circle-image-wrapper::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            border: 2px solid #D4AF37;
            border-radius: 50%;
            z-index: 11;
            pointer-events: none;
        }

    .circle-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
    }

    /* Donja kartica sa pogodnostima */
    .features-card {
        background-color: #ffffff !important;
        border: 1px solid #f1f1ef !important;
        border-radius: 16px !important;
    }

    .features-gold-bar {
        position: absolute;
        top: 0;
        left: 0;
        bottom: 0;
        width: 4px;
        background: linear-gradient(180deg, #D4AF37 0%, #F3E5AB 100%);
    }

    .tracking-wider {
        letter-spacing: 0.1em;
    }

    .tracking-widest {
        letter-spacing: 0.15em;
    }

    /* Responzivnost */
    @@media (max-width: 991.98px) {
        .brand-header-lead {
            text-align: center;
        }

        .hero-title {
            font-size: 2.6rem;
            text-align: center;
        }

        .hero-subtitle, .hero-motto {
            text-align: center;
            display: block;
        }

            .hero-motto::after {
                left: 50%;
                transform: translateX(-50%);
            }

        .text-section {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .structure-buttons {
            justify-content: center;
        }

        .main-image-wrapper {
            margin: 0 auto;
            height: 440px;
            width: 90%;
        }

        .circle-image-wrapper {
            width: 200px;
            height: 200px;
            left: 10px;
            top: 10px;
        }
    }
</style>