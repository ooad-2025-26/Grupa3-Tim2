@model SmartHairSalonApp.Models.Rezervacija

@{
    ViewData["Title"] = "Uklanjanje Rezervacije";
}

<div class="container my-5" style="max-width: 600px;">
    <div class="mb-4 pb-2 text-center border-bottom border-light">
        <h2 class="fw-bold text-uppercase tracking-wide" style="color: #dc3545; font-family: 'Playfair Display', serif;">Uklanjanje Rezervacije</h2>
        <p class="text-muted small text-uppercase tracking-wider m-0">Potvrda trajnog brisanja termina iz sistema</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div style="height: 4px; background: linear-gradient(90deg, #dc3545 0%, #ff6b6b 100%);"></div>
        <div class="card-body p-4 p-md-5">

            <div class="alert alert-danger border-0 rounded-3 d-flex align-items-center mb-4" style="background-color: #fff5f5; color: #c92a2a;">
                <span class="small fw-semibold">Pažnja: Brisanjem ovog zapisa trajno uklanjate rezervaciju iz baze salona bez mogućnosti povrata podataka.</span>
            </div>

            <div class="mb-4">
                <span class="text-muted text-uppercase tracking-wider d-block small mb-1">Usluga</span>
                <h4 class="fw-bold text-dark" style="font-family: 'Playfair Display', serif;">@Model.Usluga?.Naziv</h4>
            </div>

            <div class="mb-4">
                <span class="text-muted text-uppercase tracking-wider d-block small mb-1">Vrijeme</span>
                <p class="text-dark fw-semibold m-0 fs-5">@Model.ZeljeniTermin</p>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-between align-items-center pt-3 border-top border-light mt-5">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill text-uppercase btn-custom-outline">Nazad</a>
                    <button type="submit" class="btn btn-danger px-4 rounded-pill text-uppercase btn-delete shadow-sm">Potvrdi Brisanje</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .tracking-wider {
        letter-spacing: 0.1em;
    }

    .btn-custom-outline {
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 50px;
        transition: all 0.2s ease;
    }

        .btn-custom-outline:hover {
            border-color: #1a1a1a;
            color: #1a1a1a;
        }

    .btn-delete {
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 50px;
        background-color: #dc3545;
        border-color: #dc3545;
        transition: all 0.25s ease;
    }

        .btn-delete:hover {
            background-color: #b91c1c;
            border-color: #b91c1c;
        }
</style>