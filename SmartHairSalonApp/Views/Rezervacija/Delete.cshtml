@model SmartHairSalonApp.Models.Rezervacija

@{
    ViewData["Title"] = "Brisanje rezervacije";
}

<h1>Brisanje rezervacije</h1>

<h4>Da li ste sigurni?</h4>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Status
    </dt>
    <dd class="col-sm-9">
        @Model.StatusRezervacije
    </dd>

    <dt class="col-sm-3">
        Korisnik
    </dt>
    <dd class="col-sm-9">
        @Model.Korisnik?.UserName
    </dd>

    <dt class="col-sm-3">
        Usluga
    </dt>
    <dd class="col-sm-9">
        @Model.Usluga?.Naziv
    </dd>

    <dt class="col-sm-3">
        Željeni termin
    </dt>
    <dd class="col-sm-9">
        @Model.ZeljeniTermin
    </dd>

</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Obriši
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Nazad
    </a>
</form>