@model SmartHairSalonApp.Models.Rezervacija

@{
    ViewData["Title"] = "Detalji Rezervacije";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-5" style="max-width: 650px;">
    <div class="mb-4 pb-2 text-center border-bottom border-light">
        <h2 class="fw-bold text-uppercase tracking-wide" style="color: #1a1a1a; font-family: 'Playfair Display', serif;">Pregled Rezervacije</h2>
        <p class="text-muted small text-uppercase tracking-wider m-0">Sistemski detalji o zakazanom terminu</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div style="height: 4px; background: linear-gradient(90deg, #D4AF37 0%, #F3E5AB 100%);"></div>
        <div class="card-body p-4 p-md-5">

            <div class="row g-4">
                <div class="col-sm-6">
                    <span class="text-muted text-uppercase tracking-wider d-block small mb-1">Odabrana Usluga</span>
                    <h4 class="fw-bold text-dark" style="font-family: 'Playfair Display', serif;">@Model.Usluga?.Naziv</h4>
                </div>
                <div class="col-sm-6">
                    <span class="text-muted text-uppercase tracking-wider d-block small mb-1">Status Zahtjeva</span>
                    <div>
                        @if (Model.StatusRezervacije == SmartHairSalonApp.Models.StatusRezervacije.Potvrdjena)
                        {
                            <span class="badge rounded-pill bg-success text-white text-uppercase px-3 py-2" style="font-size:0.75rem;">Potvrđeno</span>
                        }
                        else if (Model.StatusRezervacije == SmartHairSalonApp.Models.StatusRezervacije.Odbijena)
                        {
                            <span class="badge rounded-pill bg-danger text-white text-uppercase px-3 py-2" style="font-size:0.75rem;">Odbijeno</span>
                        }
                        else
                        {
                            <span class="badge rounded-pill bg-warning text-dark text-uppercase px-3 py-2" style="font-size:0.75rem;">U Obradi</span>
                        }
                    </div>
                </div>

                <div class="col-12 border-top border-light pt-3">
                    <span class="text-muted text-uppercase tracking-wider d-block small mb-1">Rezervisano Vrijeme</span>
                    <p class="fs-5 fw-semibold text-dark m-0">
                        <i class="bi bi-calendar3 text-gold me-2"></i> @Model.ZeljeniTermin
                    </p>
                </div>

                @if (!User.IsInRole("korisnik"))
                {
                    <div class="col-12 border-top border-light pt-3">
                        <span class="text-muted text-uppercase tracking-wider d-block small mb-1">Klijent (Email)</span>
                        <p class="text-dark m-0 fw-medium">@Model.Korisnik?.Email</p>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 border-top border-light mt-5">
                <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill text-uppercase btn-custom-outline">
                    Nazad na listu
                </a>
                @if (!User.IsInRole("korisnik"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-dark px-4 rounded-pill text-uppercase btn-premium-dark shadow-sm">
                        Uredi status
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: #D4AF37 !important;
    }

    .tracking-wide {
        letter-spacing: 0.05em;
    }

    .tracking-wider {
        letter-spacing: 0.1em;
    }

    .btn-premium-dark {
        background-color: #1a1a1a;
        border: 1px solid #1a1a1a;
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.25s ease;
    }

        .btn-premium-dark:hover {
            background-color: #000000;
            border-color: #D4AF37;
        }

    .btn-custom-outline {
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 50px;
        transition: all 0.2s ease;
    }

        .btn-custom-outline:hover {
            border-color: #1a1a1a;
            color: #1a1a1a;
        }
</style>