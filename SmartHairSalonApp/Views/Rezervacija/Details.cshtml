@model SmartHairSalonApp.Models.Rezervacija

@{
    ViewData["Title"] = "Detalji rezervacije";
}

<h1>Detalji rezervacije</h1>

<hr />

<dl class="row">

    <dt class="col-sm-3">
        Status
    </dt>
    <dd class="col-sm-9">
        @Model.StatusRezervacije
    </dd>

    <dt class="col-sm-3">
        Korisnik
    </dt>
    <dd class="col-sm-9">
        @Model.Korisnik?.UserName
    </dd>

    <dt class="col-sm-3">
        Usluga
    </dt>
    <dd class="col-sm-9">
        @Model.Usluga?.Naziv
    </dd>

    <dt class="col-sm-3">
        Željeni termin
    </dt>
    <dd class="col-sm-9">
        @Model.ZeljeniTermin
    </dd>

</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
    Obradi
</a>

<a asp-action="Index" class="btn btn-secondary">
    Nazad
</a>