@model IEnumerable<SmartHairSalonApp.Models.Rezervacija>

@{
    ViewData["Title"] = "Upravljanje Rezervacijama";
    bool jeZaposlenik = User.IsInRole("zaposlenik") || User.IsInRole("Zaposlenik");
    bool jeAdmin = User.IsInRole("admin") || User.IsInRole("Admin");
    bool jeSalonOsoblje = jeZaposlenik || jeAdmin;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-5" style="min-height: 75vh;">
    <div class="mb-5 pb-3 border-bottom border-light">
        <span class="text-uppercase tracking-widest text-gold fw-bold small d-block mb-2">Smart Hair Salon</span>
        <h2 style="font-family: 'Playfair Display', serif;" class="fw-bold text-uppercase tracking-wide text-dark m-0">
            Upravljanje Rezervacijama
        </h2>
        <p class="text-muted small text-uppercase tracking-wider m-0 mt-1">Pregled i status salonskih termina.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div style="height: 4px; background: linear-gradient(90deg, #D4AF37 0%, #F3E5AB 100%);"></div>

        <div class="table-responsive">
            <table class="table align-middle mb-0 custom-table">
                <thead class="table-light text-uppercase tracking-wider small">
                    <tr>
                        <th class="py-3 px-4">Klijent</th>
                        <th class="py-3 px-4">Usluga</th>
                        <th class="py-3 px-4">Željeni Termin</th>
                        <th class="py-3 px-4">Status</th>
                        <th class="py-3 px-4 text-end pe-4">Akcije</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <i class="bi bi-calendar-x text-muted mb-2 d-block" style="font-size: 2.5rem;"></i>
                                <span class="text-muted text-uppercase tracking-wider small">Trenutno nema zakazanih termina u bazi.</span>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="py-3 px-4 text-muted small">
                                @(item.Korisnik?.Email ?? "Gost/Klijent")
                            </td>
                            <td class="py-3 px-4 fw-bold text-dark">
                                @(item.Usluga != null ? item.Usluga.Naziv : "Nije definisana")
                            </td>
                            <td class="py-3 px-4 text-muted small">
                                <i class="bi bi-clock text-gold me-1"></i> @item.ZeljeniTermin
                            </td>
                            <td class="py-3 px-4">
                                <span id="status-badge-rezervacija-@item.Id" class="badge rounded-pill text-uppercase px-3 py-2 font-xs
                                    @(item.StatusRezervacije == StatusRezervacije.UObradi ? "bg-warning-light text-warning" :
                                        item.StatusRezervacije == StatusRezervacije.Potvrdjena ? "bg-success-light text-success" :
                                        "bg-danger-light text-danger")">
                                    @(item.StatusRezervacije == StatusRezervacije.UObradi ? "U Obradi" :
                                      item.StatusRezervacije == StatusRezervacije.Potvrdjena ? "Potvrđeno" : "Odbijeno")
                                </span>
                            </td>
                            <td class="py-3 px-4 text-end pe-4">
                                <div id="akcije-rezervacija-@item.Id" class="d-inline-flex gap-2">
                                    @if (jeSalonOsoblje && item.StatusRezervacije == StatusRezervacije.UObradi)
                                    {
                                        <button onclick="procesuirajRezervaciju(@item.Id, 'Potvrdjena')" class="btn btn-light btn-sm rounded-circle border shadow-sm px-2" title="Potvrdi termin">
                                            <i class="bi bi-check-lg text-success"></i>
                                        </button>
                                        <button onclick="procesuirajRezervaciju(@item.Id, 'Odbijena')" class="btn btn-light btn-sm rounded-circle border shadow-sm px-2" title="Odbij termin">
                                            <i class="bi bi-x-lg text-danger"></i>
                                        </button>
                                    }

                                    <a href="/Rezervacija/Details/@item.Id" class="btn btn-light btn-sm rounded border px-2" title="Detalji"><i class="bi bi-info-circle"></i></a>
                                    <a href="/Rezervacija/Edit/@item.Id" class="btn btn-light btn-sm rounded border px-2" title="Uredi"><i class="bi bi-pencil-square"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: #D4AF37 !important;
    }

    .tracking-wide {
        letter-spacing: 0.05em;
    }

    .tracking-wider {
        letter-spacing: 0.1em;
    }

    .tracking-widest {
        letter-spacing: 0.2em;
    }

    .font-xs {
        font-size: 0.7rem;
        font-weight: 600;
    }

    .custom-table th {
        background-color: #fafafa;
        border-bottom: 1px solid #f1f1ef;
        padding: 16px 12px;
        color: #666;
        font-size: 0.75rem;
    }

    .custom-table td {
        padding: 18px 12px;
        border-bottom: 1px solid #f8f9fa;
    }

    .bg-success-light {
        background-color: #ebfbee !important;
    }

    .bg-danger-light {
        background-color: #fff5f5 !important;
    }

    .bg-warning-light {
        background-color: #fff9db !important;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function procesuirajRezervaciju(id, statusOdluke) {
        let naslov = statusOdluke === 'Potvrdjena' ? 'Želite li potvrditi ovaj termin?' : 'Želite li odbiti ovaj termin?';
        let tekst = statusOdluke === 'Potvrdjena' ? 'Klijentov termin će biti odobren.' : 'Ovaj salonski termin će biti otkazan.';
        let ikona = statusOdluke === 'Potvrdjena' ? 'question' : 'warning';
        let dugmeBoja = statusOdluke === 'Potvrdjena' ? '#198754' : '#dc3545';

        Swal.fire({
        title: naslov,
        text: tekst,
        icon: ikona,
        showCancelButton: true,
        confirmButtonColor: dugmeBoja,
        cancelButtonColor: '#6c757d',
        confirmButtonText: statusOdluke === 'Potvrdjena' ? 'Da, potvrdi!' : 'Da, odbij!',
        cancelButtonText: 'Odustani'
        }).then((result) => {
        if (result.isConfirmed) {
        fetch(`/Rezervacija/PromijeniStatusRezervacije?id=${id}&status=${statusOdluke}`, { method: 'POST' })
        .then(res => res.json())
        .then(data => {
        if (data.success) {
        let badge = document.getElementById(`status-badge-rezervacija-${id}`);
        if (badge) {
        badge.innerText = data.noviStatusText;
        if (statusOdluke === 'Potvrdjena') {
        badge.className = "badge rounded-pill text-uppercase px-3 py-2 font-xs bg-success-light text-success";
        } else {
        badge.className = "badge rounded-pill text-uppercase px-3 py-2 font-xs bg-danger-light text-danger";
        }
        }

        let akcijeDiv = document.getElementById(`akcije-rezervacija-${id}`);
        if (akcijeDiv) {
        let buttons = akcijeDiv.querySelectorAll('button');
        buttons.forEach(btn => btn.remove());
        }

        Swal.fire({
        title: statusOdluke === 'Potvrdjena' ? 'Termin Potvrđen!' : 'Termin Odbijen!',
        text: `Uspješno ažuriran status salonskog termina.`,
        icon: 'success',
        timer: 2000,
        showConfirmButton: false
        });
        }
        })
        .catch(err => {
        console.error("Greška:", err);
        Swal.fire('Greška', 'Nije moguće promijeniti status termina.', 'error');
        });
        }
        });
        }
    </script>
}