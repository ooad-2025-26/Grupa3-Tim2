@model IEnumerable<SmartHairSalonApp.Models.Rezervacija>

@{
    ViewData["Title"] = "Lista Rezervacija";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-5">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-5 pb-3 border-bottom border-light">
        <div>
            <h2 class="fw-bold text-uppercase tracking-wide m-0" style="color: #1a1a1a; font-family: 'Playfair Display', serif;">
                @(User.IsInRole("korisnik") ? "Moje Rezervacije" : "Upravljanje Rezervacijama")
            </h2>
            <p class="text-muted small text-uppercase tracking-wider m-0 mt-1">Pregled i status salonskih termina</p>
        </div>
        @if (User.IsInRole("korisnik"))
        {
            <a asp-action="Create" class="btn btn-dark shadow-sm px-4 fw-semibold rounded-pill text-uppercase btn-premium-dark mt-3 mt-sm-0">
                Nova Rezervacija
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="text-center p-5 bg-white shadow-sm rounded-4 border border-light">
            <i class="bi bi-calendar-x text-muted mb-3 d-block" style="font-size: 3rem;"></i>
            <p class="text-muted text-uppercase tracking-wider small m-0">Trenutno nema evidentiranih rezervacija.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
            <div style="height: 4px; background: linear-gradient(90deg, #D4AF37 0%, #F3E5AB 100%);"></div>
            <div class="table-responsive">
                <table class="table align-middle mb-0 custom-table">
                    <thead class="table-light text-uppercase tracking-wider small">
                        <tr>
                            @if (!User.IsInRole("korisnik"))
                            {
                                <th class="ps-4">Klijent</th>
                            }
                            <th class="@(User.IsInRole("korisnik") ? "ps-4" : "")">Usluga</th>
                            <th>Željeni Termin</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Akcije</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                @if (!User.IsInRole("korisnik"))
                                {
                                    <td class="ps-4 fw-semibold text-dark">@item.Korisnik?.Email</td>
                                }
                                <td class="@(User.IsInRole("korisnik") ? "ps-4" : "") fw-bold text-dark" style="font-family: 'Playfair Display', serif; font-size: 1.1rem;">
                                    @item.Usluga?.Naziv
                                </td>
                                <td class="text-muted small">
                                    <i class="bi bi-clock text-gold me-1"></i> @item.ZeljeniTermin
                                </td>
                                <td>
                                    @if (item.StatusRezervacije == SmartHairSalonApp.Models.StatusRezervacije.Potvrdjena)
                                    {
                                        <span class="badge rounded-pill bg-success-light text-success text-uppercase px-3 py-2 font-xs">Potvrđeno</span>
                                    }
                                    else if (item.StatusRezervacije == SmartHairSalonApp.Models.StatusRezervacije.Odbijena)
                                    {
                                        <span class="badge rounded-pill bg-danger-light text-danger text-uppercase px-3 py-2 font-xs">Odbijeno</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-warning-light text-warning text-uppercase px-3 py-2 font-xs">U Obradi</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm rounded-3 overflow-hidden border border-light bg-white">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-white btn-sm px-3 border-end" title="Detalji">
                                            <i class="bi bi-info-circle text-muted"></i>
                                        </a>

                                        @if (!User.IsInRole("korisnik"))
                                        {
                                            @if (item.StatusRezervacije == SmartHairSalonApp.Models.StatusRezervacije.UObradi)
                                            {
                                                <a asp-action="Prihvati" asp-route-id="@item.Id" class="btn btn-white btn-sm px-3 border-end" title="Prihvati">
                                                    <i class="bi bi-check2 text-success fw-bold"></i>
                                                </a>
                                                <a asp-action="Odbij" asp-route-id="@item.Id" class="btn btn-white btn-sm px-3 border-end" title="Odbij">
                                                    <i class="bi bi-x-lg text-danger"></i>
                                                </a>
                                            }
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-white btn-sm px-3 border-end" title="Uredi">
                                                <i class="bi bi-pencil-square text-dark"></i>
                                            </a>
                                            @if (User.IsInRole("admin"))
                                            {
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-white btn-sm px-3" title="Obriši">
                                                    <i class="bi bi-trash3-fill text-danger"></i>
                                                </a>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<style>
    .text-gold {
        color: #D4AF37 !important;
    }

    .tracking-wide {
        letter-spacing: 0.05em;
    }

    .tracking-wider {
        letter-spacing: 0.1em;
    }

    .font-xs {
        font-size: 0.7rem;
        font-weight: 600;
    }

    .btn-premium-dark {
        background-color: #1a1a1a;
        border: 1px solid #1a1a1a;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.05em;
        transition: all 0.25s ease;
    }

        .btn-premium-dark:hover {
            background-color: #000000;
            border-color: #D4AF37;
        }

    .custom-table th {
        background-color: #fafafa;
        border-bottom: 1px solid #f1f1ef;
        padding: 16px 12px;
        color: #666;
        font-size: 0.75rem;
    }

    .custom-table td {
        padding: 18px 12px;
        border-bottom: 1px solid #f8f9fa;
    }

    .bg-success-light {
        background-color: #ebfbee;
    }

    .bg-danger-light {
        background-color: #fff5f5;
    }

    .bg-warning-light {
        background-color: #fff9db;
    }

    .btn-white {
        background-color: #ffffff;
        border: none;
    }

        .btn-white:hover {
            background-color: #fafafa;
        }
</style>