@model IEnumerable<SmartHairSalonApp.Models.Rezervacija>

@{
    ViewData["Title"] = "Rezervacije";
}

<h1>Rezervacije</h1>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Status</th>
            <th>Korisnik</th>
            <th>Usluga</th>
            <th>Željeni termin</th>
            <th>Akcije</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.StatusRezervacije</td>
                <td>@item.Korisnik?.UserName</td>
                <td>@item.Usluga?.Naziv</td>
                <td>@item.ZeljeniTermin</td>
                <td>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">
                        Detalji
                    </a>

                    @if (User.IsInRole("admin") || User.IsInRole("zaposlenik"))
                    {
                        <a asp-action="Prihvati"
                           asp-route-id="@item.Id"
                           class="btn btn-success btn-sm">
                            Prihvati
                        </a>

                        <a asp-action="Odbij"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            Odbij
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Obriši
                        </a>
                    }

                </td>
            </tr>
        }
    </tbody>
</table>