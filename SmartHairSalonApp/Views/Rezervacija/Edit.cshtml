@model SmartHairSalonApp.Models.Rezervacija

@{
    ViewData["Title"] = "Obrada rezervacije";
}

<h1>Obrada rezervacije</h1>

<hr />

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="card shadow p-4">

            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="KorisnikId" />
                <input type="hidden" asp-for="UslugaId" />

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Željeni termin korisnika
                    </label>

                    <input asp-for="ZeljeniTermin"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="StatusRezervacije"
                           class="form-label fw-bold">
                    </label>

                    <select asp-for="StatusRezervacije"
                            asp-items="Html.GetEnumSelectList<SmartHairSalonApp.Models.StatusRezervacije>()"
                            class="form-select">
                    </select>

                    <span asp-validation-for="StatusRezervacije"
                          class="text-danger">
                    </span>
                </div>

                <div class="text-center">
                    <button type="submit"
                            class="btn btn-success px-4">
                        Sačuvaj promjene
                    </button>
                </div>

            </form>

        </div>

    </div>
</div>

<div class="mt-3 text-center">
    <a asp-action="Index" class="btn btn-secondary">
        Nazad
    </a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}