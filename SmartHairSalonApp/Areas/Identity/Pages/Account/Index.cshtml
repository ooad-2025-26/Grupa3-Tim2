@page
@model SmartHairSalonApp.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "Moj Profil";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-5" style="max-width: 500px;">
    <div class="text-center mb-4">
        <span class="text-uppercase tracking-widest text-gold fw-bold small d-block mb-2">Smart Hair Salon</span>
        <h2 class="fw-bold text-uppercase tracking-wide text-dark" style="font-family: 'Playfair Display', serif;">Moj Profil</h2>
    </div>

    @if (!string.IsNullOrEmpty(Model.StatusMessage))
    {
        <div class="alert bg-white text-gold border-gold rounded-3 text-center small tracking-wide p-3 mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @Model.StatusMessage
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
        <div style="height: 4px; background: linear-gradient(90deg, #D4AF37 0%, #F3E5AB 100%);"></div>

        <div class="card-body p-4 p-md-5">
            <form id="profile-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3" role="alert"></div>

                <div class="form-group mb-4">
                    <label asp-for="Username" class="form-label text-muted text-uppercase tracking-wider small fw-semibold">Korisničko ime / Email</label>
                    <input asp-for="Username" class="form-control custom-input bg-light text-muted" readonly style="cursor: not-allowed;" />
                    <small class="text-muted font-italic d-block mt-1" style="font-size: 0.75rem;">Korisničko ime se ne može mijenjati.</small>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Input.PhoneNumber" class="form-label text-muted text-uppercase tracking-wider small fw-semibold">Broj telefona</label>
                    <input asp-for="Input.PhoneNumber" class="form-control custom-input" placeholder="Unesite vaš broj telefona (npr. 061123456)" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                </div>

                <button id="update-profile-button" type="submit" class="btn btn-dark w-100 rounded-pill text-uppercase btn-premium-dark shadow-sm py-3 mt-2">
                    Spasi izmjene
                </button>

                <div class="text-center mt-4 pt-3 border-top border-light">
                    <p class="m-0 small text-muted">
                        Sigurnost računa?
                        <a asp-page="./ChangePassword" class="text-gold fw-semibold text-decoration-none ms-1 hover-underline">
                            <i class="bi bi-shield-lock me-1"></i>Izmijeni lozinku
                        </a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* Premium Klase i Tipografija */
    .text-gold {
        color: #D4AF37 !important;
    }

    .border-gold {
        border-color: #D4AF37 !important;
    }

    .tracking-wide {
        letter-spacing: 0.05em;
    }

    .tracking-wider {
        letter-spacing: 0.1em;
    }

    .tracking-widest {
        letter-spacing: 0.2em;
    }

    /* Dizajn input polja */
    .custom-input {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        padding: 12px 16px;
        font-size: 0.95rem;
        transition: all 0.2s ease;
        color: #212529;
    }

        .custom-input:focus {
            border-color: #D4AF37;
            box-shadow: 0 0 0 3px rgba(212, 175, 55, 0.15);
            outline: none;
            background-color: #ffffff;
        }

    /* Dizajn premium tamnog dugmeta */
    .btn-premium-dark {
        background-color: #1a1a1a;
        border: 1px solid #1a1a1a;
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        transition: all 0.25s ease;
    }

        .btn-premium-dark:hover {
            background-color: #000000;
            border-color: #D4AF37;
            color: #D4AF37 !important;
        }

    .hover-underline:hover {
        text-decoration: underline !important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}