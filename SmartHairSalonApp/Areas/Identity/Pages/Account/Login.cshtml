@page
@model LoginModel

@{
    ViewData["Title"] = "Prijava";
}

<h1 class="ms-4 mt-3">@ViewData["Title"]</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

<div class="row justify-content-around mt-4">
    <!-- Login forma -->
    <div class="col-lg-4 col-md-6">
        <section>
            <form id="account" method="post">
                <h2>Dobrodošli nazad</h2>
                <p class="text-muted">Unesite svoje podatke za prijavu.</p>
                <hr />

                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" />
                    <label asp-for="Input.Email">Email</label>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" />
                    <label asp-for="Input.Password">Lozinka</label>
                </div>

                <div class="checkbox mb-3">
                    <label asp-for="Input.RememberMe">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        Zapamti me
                    </label>
                </div>

                <button id="login-submit" type="submit" class="w-100 btn btn-lg text-white"
                        style="background-color:#d63384; border-color:#d63384;">
                    Prijavi se
                </button>

             
            </form>
        </section>
    </div>

    <!-- Registracija -->
    <div class="col-lg-3 col-md-4 d-flex align-items-center">
        <div>
            <h4 class="fw-bold">Nemate još račun?</h4>

            <p class="text-muted">
                Pridružite se našoj zajednici ljepote i rezervišite svoj termin za nekoliko sekundi.
            </p>

            <a asp-page="./Register"
               asp-route-returnUrl="@Model.ReturnUrl"
               class="btn text-white"
               style="background-color:#d63384; border-color:#d63384;">
                Registruj se
            </a>
        </div>
    </div>
</>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
